@model DatLichKhamBenh.Models.ViewModels.KhamBenhViewModel
@{
    ViewData["Title"] = "Khám bệnh & Kê đơn";
    Layout = "~/Areas/Doctor/Views/Shared/_LayoutDoctor.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Phiếu khám bệnh</h2>
        <p class="text-muted mb-0">Nhập kết quả khám cho bệnh nhân đã check-in.</p>
    </div>
    <span class="badge bg-secondary fs-6">Mã lịch: @ViewBag.AppointmentCode</span>
</div>

<form action="/Doctor/Examination/Complete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="LichHenId" value="@Model.LichHenId">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-4">
        <div class="col-lg-4">
            <section class="card p-4 h-100">
                <h3 class="card-title"><i class="fas fa-user"></i> Thông tin bệnh nhân</h3>
                <p><strong>Họ tên:</strong> @ViewBag.PatientName</p>
                <p><strong>Tuổi:</strong> @ViewBag.PatientAge</p>
                <p><strong>Số điện thoại:</strong> @ViewBag.PatientPhone</p>
                <p><strong>Ngày khám:</strong> @ViewBag.AppointmentDate</p>
                <p class="mb-0"><strong>Triệu chứng:</strong><br>@ViewBag.Symptoms</p>
            </section>
        </div>
        <div class="col-lg-8">
            <section class="card p-4">
                <div class="form-group">
                    <label class="form-label" for="KetQuaLamSang">Kết quả lâm sàng <span class="text-danger">*</span></label>
                    <textarea id="KetQuaLamSang" name="KetQuaLamSang" class="form-control" rows="3" required>@Model.KetQuaLamSang</textarea>
                    <span asp-validation-for="KetQuaLamSang" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" for="ChanDoan">Chẩn đoán <span class="text-danger">*</span></label>
                    <textarea id="ChanDoan" name="ChanDoan" class="form-control" rows="3" required>@Model.ChanDoan</textarea>
                    <span asp-validation-for="ChanDoan" class="text-danger"></span>
                </div>

                <h3 class="card-title mt-3"><i class="fas fa-prescription-bottle-medical"></i> Đơn thuốc</h3>
                <div class="table-responsive">
                    <table class="table align-middle" id="medicineTable">
                        <thead><tr><th>Tên thuốc</th><th>Liều lượng</th><th>Số lượng</th><th></th></tr></thead>
                        <tbody>
                            <tr>
                                <td><input class="form-control" name="DanhSachThuoc[0].TenThuoc" placeholder="Tên thuốc"></td>
                                <td><input class="form-control" name="DanhSachThuoc[0].LieuLuong" placeholder="Cách dùng"></td>
                                <td><input type="number" min="1" value="1" class="form-control" name="DanhSachThuoc[0].SoLuong"></td>
                                <td><button type="button" class="btn btn-outline-danger" onclick="removeMedicineRow(this)" aria-label="Xóa thuốc"><i class="fas fa-trash"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-outline mb-3 align-self-start" onclick="addMedicineRow()"><i class="fas fa-plus"></i> Thêm thuốc</button>

                <div class="form-group">
                    <label class="form-label" for="LoiDan">Lời dặn</label>
                    <textarea id="LoiDan" name="LoiDan" class="form-control" rows="2">@Model.LoiDan</textarea>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a href="/Doctor/Doctor/Index" class="btn btn-outline">Quay lại</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Hoàn thành ca khám</button>
                </div>
            </section>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function renumberMedicineRows() {
            document.querySelectorAll('#medicineTable tbody tr').forEach(function (row, index) {
                row.querySelectorAll('input[name]').forEach(function (input) {
                    input.name = input.name.replace(/DanhSachThuoc\[\d+\]/, 'DanhSachThuoc[' + index + ']');
                });
            });
        }

        function addMedicineRow() {
            const body = document.querySelector('#medicineTable tbody');
            const row = body.insertRow();
            row.innerHTML = `
                <td><input class="form-control" name="DanhSachThuoc[0].TenThuoc" placeholder="Tên thuốc"></td>
                <td><input class="form-control" name="DanhSachThuoc[0].LieuLuong" placeholder="Cách dùng"></td>
                <td><input type="number" min="1" value="1" class="form-control" name="DanhSachThuoc[0].SoLuong"></td>
                <td><button type="button" class="btn btn-outline-danger" onclick="removeMedicineRow(this)" aria-label="Xóa thuốc"><i class="fas fa-trash"></i></button></td>
            `;
            renumberMedicineRows();
        }

        function removeMedicineRow(button) {
            button.closest('tr').remove();
            renumberMedicineRows();
        }
    </script>
}
