@{
    ViewData["Title"] = "Khám bệnh & Kê đơn";
    Layout = "~/Areas/Doctor/Views/Shared/_LayoutDoctor.cshtml";
}

<!-- ĐOẠN CODE HIỂN THỊ THÔNG BÁO THÀNH CÔNG -->
@if (TempData["SuccessMessage"] != null)
{
    <div style="background: #dcfce7; color: #15803d; padding: 15px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; border: 1px solid #bbf7d0;">
        <i class="fas fa-check-circle" style="font-size: 18px;"></i>
        <strong>@TempData["SuccessMessage"]</strong>
    </div>
}

<form action="/Doctor/Examination/Complete" method="POST">
    <div class="row" style="display: flex; gap: 20px; flex-wrap: wrap;">
        
        <!-- THÔNG TIN BỆNH NHÂN -->
        <div style="flex: 1; min-width: 300px;">
            <div class="card" style="border-left: 4px solid var(--primary);">
                <h3 class="card-title"><i class="fas fa-user"></i> Thông tin Bệnh nhân</h3>
                <p><strong>Họ tên:</strong> Nguyễn Văn A</p>
                <p><strong>Tuổi:</strong> 29</p>
                <p><strong>Triệu chứng:</strong> Đau họng, sốt cao.</p>
                <hr style="margin: 15px 0; border-top: 1px dashed var(--border);">
                <p><strong>Huyết áp:</strong> 120/80 mmHg</p>
                <p><strong>Nhịp tim:</strong> 85 bpm</p>
                <p><strong>Nhiệt độ:</strong> 38.5 °C</p>
            </div>
        </div>

        <!-- FORM KHÁM BỆNH -->
        <div style="flex: 2; min-width: 400px;">
            <div class="card">
                <div class="form-group">
                    <label class="form-label">Kết quả lâm sàng <span style="color:red">*</span></label>
                    <textarea class="form-control" name="KetQuaLamSang" required placeholder="Nhập kết quả..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Chẩn đoán bệnh <span style="color:red">*</span></label>
                    <textarea class="form-control" name="ChanDoan" required placeholder="Nhập chẩn đoán..."></textarea>
                </div>

                <h4 style="margin: 20px 0 10px; font-size: 15px;">Đơn thuốc</h4>
                <table class="table" id="tblThuoc">
                    <thead>
                        <tr>
                            <th>Tên thuốc</th>
                            <th>Liều lượng</th>
                            <th>Số lượng</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="text" class="form-control" name="DanhSachThuoc[0].TenThuoc" required></td>
                            <td><input type="text" class="form-control" name="DanhSachThuoc[0].LieuLuong"></td>
                            <td><input type="number" class="form-control" name="DanhSachThuoc[0].SoLuong" value="1"></td>
                            <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">Xóa</button></td>
                        </tr>
                    </tbody>
                </table>
                <button type="button" class="btn btn-outline" style="margin-bottom: 20px;" onclick="addRow()"><i class="fas fa-plus"></i> Thêm thuốc</button>

                <div class="form-group">
                    <label class="form-label">Lời dặn</label>
                    <textarea class="form-control" name="LoiDan" rows="2"></textarea>
                </div>

                <div style="text-align: right;">
                    <a href="/Doctor/Home/Index" class="btn btn-outline">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Hoàn thành ca khám</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let rowIdx = 1;
        function addRow() {
            let tbody = document.querySelector('#tblThuoc tbody');
            let tr = document.createElement('tr');
            tr.innerHTML = `
                <td><input type="text" class="form-control" name="DanhSachThuoc[${rowIdx}].TenThuoc" required></td>
                <td><input type="text" class="form-control" name="DanhSachThuoc[${rowIdx}].LieuLuong"></td>
                <td><input type="number" class="form-control" name="DanhSachThuoc[${rowIdx}].SoLuong" value="1"></td>
                <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">Xóa</button></td>
            `;
            tbody.appendChild(tr);
            rowIdx++;
        }
        function removeRow(btn) {
            btn.closest('tr').remove();
        }
    </script>
}