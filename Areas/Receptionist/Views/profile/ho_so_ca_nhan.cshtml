@using System.Collections.Generic
@{
    Layout = null;
    string receptionistName = (ViewBag.ReceptionistName as string) ?? "";
    string receptionistEmail = (ViewBag.ReceptionistEmail as string) ?? "";
    string receptionistPhone = (ViewBag.ReceptionistPhone as string) ?? "";
    string receptionistAddress = (ViewBag.ReceptionistAddress as string) ?? "";
    string receptionistCode = (ViewBag.ReceptionistCode as string) ?? "";

    string trimmedName = receptionistName.Trim();
    string initials = trimmedName.Length >= 2 ? trimmedName.Substring(0, 2).ToUpper() : (trimmedName.Length == 1 ? trimmedName.ToUpper() : "—");
    string cloverLogoUrl = Url.Content("~/static/images/logo-clover.png");

    string urlTongQuan = Url.Action("Index", "dashboard_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/dashboard_le_tan";
    string urlQuanLyLichHen = Url.Action("Index", "quan_ly_lich_hen_BN", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_hen_BN";
    string urlDanhSachCaTruc = Url.Action("Index", "quan_ly_lich_lam_viec_BS", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_lam_viec_BS";
    string urlVienPhi = Url.Action("Index", "vien_phi", new { area = "Receptionist" }) ?? "/Receptionist/vien_phi";
    string urlHoSoCaNhan = Url.Action("Index", "ho_so_ca_nhan_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/ho_so_ca_nhan_le_tan";

    string urlUpdateProfile = Url.Action("UpdateProfile", "ho_so_ca_nhan_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/ho_so_ca_nhan_le_tan/UpdateProfile";
    string urlChangePassword = Url.Action("ChangePassword", "ho_so_ca_nhan_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/ho_so_ca_nhan_le_tan/ChangePassword";

    string tempSuccess = TempData["Success"]?.ToString() ?? "";
    string tempError = TempData["Error"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediSlot - Hồ sơ Lễ tân</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/static/css/LT_BS.css" asp-append-version="true">
    <style>
        :root {
            --bg-body: #f4f7fb; --bg-card: #ffffff; --text-color: #1e293b; --text-gray: #64748b;
            --secondary-color: #0f172a; --border-color: #e2e8f0; --primary-blue: #2563eb;
            --primary-blue-light: #eff6ff; --primary-blue-soft: rgba(37, 99, 235, 0.08);
            --radius: 14px; --shadow: 0 4px 18px rgba(15, 23, 42, 0.04); --shell-max: 1480px; --shell-pad: 24px;
        }
        html, body { max-width: 100%; overflow-x: hidden; margin: 0; font-family: 'Poppins', sans-serif; background: var(--bg-body); color: var(--text-color); }
        header {
            width: calc(100% - var(--shell-pad) * 2) !important; max-width: var(--shell-max) !important; margin: 10px auto 15px !important;
            padding: 10px 24px !important; display: flex !important; justify-content: space-between !important; align-items: center !important;
            flex-wrap: wrap !important; gap: 12px !important; background: var(--bg-card); border-radius: 14px !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); box-sizing: border-box !important;
        }
        .logo-container, .footer-logo { display: flex; align-items: center; gap: 12px; }
        .footer-logo { justify-content: center; }
        .brand-clover { width: 42px; height: 42px; border-radius: 12px; background: #fff; border: 1px solid var(--border-color); padding: 4px; box-sizing: border-box; flex-shrink: 0; overflow: hidden; }
        .brand-clover img, .brand-clover svg { width: 100%; height: 100%; object-fit: contain; display: block; }
        .brand-title { margin: 0; font-size: 19px; font-weight: 700; line-height: 1.15; background: linear-gradient(135deg, var(--primary-blue) 0%, #6366f1 55%, #ec4899 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .logo-text p { margin: 0; font-size: 11.5px; color: var(--text-gray); }
        header nav ul { display: flex !important; gap: 14px !important; align-items: center !important; flex-wrap: wrap !important; margin: 0 !important; padding: 0 !important; list-style: none !important; }
        header nav ul li a { font-size: 13.5px !important; font-weight: 500; white-space: nowrap !important; padding: 8px 12px !important; color: var(--text-color); text-decoration: none; border-radius: 8px; }
        header nav ul li a:hover { background: var(--primary-blue-soft); color: var(--primary-blue); }
        .header-right, .user-badge { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .user-badge { cursor: pointer; white-space: nowrap !important; padding: 6px 14px !important; border-radius: 999px; background: var(--bg-body); border: 1px solid var(--border-color); }
        .user-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--primary-blue); color: #fff; font-weight: 600; font-size: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .user-name { font-size: 13.5px !important; font-weight: 600; max-width: 140px !important; overflow: hidden !important; text-overflow: ellipsis !important; }
        .user-role { font-size: 11px; color: var(--text-gray); }
        .logout-btn { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #EF4444; font-size: 16px; }
        .logout-btn:hover { background: #EF4444; color: #fff; }
        main { width: 100%; max-width: 1120px; margin: 16px auto 70px; padding: 0 var(--shell-pad); box-sizing: border-box; }
        .toast-alert { padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; font-size: 13px; font-weight: 500; }
        .toast-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .toast-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        .profile-header { background: linear-gradient(135deg, var(--primary-blue), #60a5fa); border-radius: var(--radius); padding: 28px; color: #fff; margin-bottom: 22px; display: flex; align-items: center; gap: 22px; box-shadow: var(--shadow); }
        .profile-avatar { width: 84px; height: 84px; border-radius: 50%; background: rgba(255,255,255,0.22); border: 3px solid rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 700; flex-shrink: 0; }
        .profile-info h2 { margin: 0 0 6px; font-size: 22px; color: #fff; }
        .profile-info p { margin: 0 0 10px; font-size: 13px; color: rgba(255,255,255,0.92); }
        .profile-badges { display: flex; gap: 8px; flex-wrap: wrap; }
        .profile-badge { background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 600; }
        .profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
        .card { background: var(--bg-card); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow); border: 1px solid var(--border-color); }
        .card-header { margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); }
        .card-header h3 { margin: 0; font-size: 16px; color: var(--secondary-color); }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 5px; color: var(--secondary-color); }
        .form-group input { width: 100%; height: 40px; padding: 0 12px; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-body); color: var(--text-color); font-family: 'Poppins', sans-serif; font-size: 13px; box-sizing: border-box; }
        .form-group input[readonly] { opacity: 0.7; cursor: not-allowed; }
        .btn-submit { background: var(--primary-blue); color: #fff; border: none; height: 42px; border-radius: 10px; font-family: 'Poppins', sans-serif; font-size: 13.5px; font-weight: 600; cursor: pointer; width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
        .btn-submit:hover { background: #1d4ed8; }
        .btn-submit.secondary { background: #0f172a; }
        .btn-submit.secondary:hover { background: #1e293b; }
        .modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 16px; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: var(--bg-card); color: var(--text-color); padding: 24px; border-radius: var(--radius); width: 100%; max-width: 460px; box-sizing: border-box; }
        footer { width: calc(100% - var(--shell-pad) * 2); max-width: var(--shell-max); margin: 36px auto 24px; padding: 24px; box-sizing: border-box; background: var(--bg-card); border-radius: var(--radius); border: 1px solid var(--border-color); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; font-size: 13px; color: var(--text-gray); text-align: center; }
        footer > div { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        footer h4 { margin: 0 0 10px; color: var(--secondary-color); }
        @@media (max-width: 820px) { .profile-grid { grid-template-columns: 1fr; } .profile-header { flex-direction: column; text-align: center; } }
    </style>
</head>
<body>
<header>
    <div class="logo-container">
        <div class="brand-clover">
            <img src="@cloverLogoUrl" alt="MediSlot" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <svg viewBox="0 0 100 100" style="display:none;"><path d="M46 46 C46 28, 22 24, 16 38 C12 48, 26 56, 46 46 Z" fill="#cfa0e3" /><path d="M54 46 C54 28, 78 24, 84 38 C88 48, 74 56, 54 46 Z" fill="#77b82a" /><path d="M46 54 C46 72, 22 76, 16 62 C12 52, 26 44, 46 54 Z" fill="#239be7" /><path d="M54 54 C54 72, 78 76, 84 62 C88 52, 74 44, 54 54 Z" fill="none" stroke="#e5a9b5" stroke-width="4" /></svg>
        </div>
        <div class="logo-text"><h1 class="brand-title">MediSlot</h1><p>Cổng Lễ Tân</p></div>
    </div>
    <div class="header-right">
        <nav>
            <ul>
                <li><a href="@urlTongQuan">Tổng quan</a></li>
                <li><a href="@urlQuanLyLichHen">Quản lý lịch hẹn</a></li>
                <li><a href="@urlDanhSachCaTruc">Danh sách ca trực</a></li>
                <li><a href="@urlVienPhi">Viện phí</a></li>
            </ul>
        </nav>
        <div class="user-badge" onclick="window.location.href='@urlHoSoCaNhan'" title="Hồ sơ cá nhân lễ tân">
            <div class="user-avatar">@initials</div>
            <div><div class="user-name">@(string.IsNullOrWhiteSpace(receptionistName) ? "Chưa có" : receptionistName)</div><div class="user-role">Lễ tân</div></div>
        </div>
        <button type="button" class="logout-btn" onclick="window.location.href='/Account/Login'" title="Đăng xuất"><i class="fas fa-sign-out-alt"></i></button>
    </div>
</header>

<main>
    <div class="breadcrumb"><a href="@urlTongQuan"><i class="fas fa-home"></i> Tổng quan</a><i class="fas fa-chevron-right"></i><span>Hồ sơ cá nhân</span></div>
    @if (!string.IsNullOrWhiteSpace(tempSuccess)) { <div class="toast-alert toast-success"><i class="fas fa-check-circle"></i> @tempSuccess</div> }
    @if (!string.IsNullOrWhiteSpace(tempError)) { <div class="toast-alert toast-error"><i class="fas fa-exclamation-circle"></i> @tempError</div> }

    <div class="profile-header">
        <div class="profile-avatar">@initials</div>
        <div class="profile-info">
            <h2>@(string.IsNullOrWhiteSpace(receptionistName) ? "Chưa có" : receptionistName)</h2>
            <p><i class="fas fa-envelope"></i> @(string.IsNullOrWhiteSpace(receptionistEmail) ? "Chưa có" : receptionistEmail) &nbsp;&nbsp; <i class="fas fa-phone"></i> @(string.IsNullOrWhiteSpace(receptionistPhone) ? "Chưa có" : receptionistPhone)</p>
            <div class="profile-badges">
                @if (!string.IsNullOrWhiteSpace(receptionistCode))
                {
                    <span class="profile-badge"><i class="fas fa-id-badge"></i> Mã: @receptionistCode</span>
                }
                <span class="profile-badge"><i class="fas fa-user-tie"></i> Lễ tân</span>
                <span class="profile-badge"><i class="fas fa-clinic-medical"></i> MediSlot</span>
            </div>
        </div>
    </div>

    <div class="profile-grid">
        <div class="card">
            <div class="card-header"><h3><i class="fas fa-user-circle"></i> Thông tin cá nhân</h3></div>
            <form id="profileForm" onsubmit="event.preventDefault(); updateInfo();">
                <div class="form-group"><label for="fullname">Họ và tên</label><input type="text" id="fullname" value="@receptionistName" required></div>
                <div class="form-group"><label for="email">Email công việc</label><input type="email" id="email" value="@receptionistEmail" readonly></div>
                <div class="form-group"><label for="phone">Số điện thoại</label><input type="tel" id="phone" value="@receptionistPhone"></div>
                <div class="form-group"><label for="address">Địa chỉ</label><input type="text" id="address" value="@receptionistAddress"></div>
                <button type="submit" class="btn-submit"><i class="fas fa-save"></i> Cập nhật thông tin</button>
            </form>
        </div>

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-shield-alt"></i> Đổi mật khẩu</h3></div>
            <form id="passwordForm" onsubmit="event.preventDefault(); changePassword();">
                <div class="form-group"><label for="current-pass">Mật khẩu hiện tại</label><input type="password" id="current-pass" placeholder="Nhập mật khẩu cũ..." required></div>
                <div class="form-group"><label for="new-pass">Mật khẩu mới</label><input type="password" id="new-pass" placeholder="Nhập mật khẩu mới..." required></div>
                <div class="form-group"><label for="confirm-pass">Xác nhận mật khẩu mới</label><input type="password" id="confirm-pass" placeholder="Nhập lại mật khẩu mới..." required></div>
                <button type="submit" class="btn-submit secondary"><i class="fas fa-key"></i> Đổi mật khẩu</button>
            </form>
        </div>
    </div>
</main>
<footer>
    <div>
        <div class="footer-logo">
            <div class="brand-clover"><img src="@cloverLogoUrl" alt="MediSlot" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" /><svg viewBox="0 0 100 100" style="display:none;"><path d="M46 46 C46 28, 22 24, 16 38 C12 48, 26 56, 46 46 Z" fill="#cfa0e3" /><path d="M54 46 C54 28, 78 24, 84 38 C88 48, 74 56, 54 46 Z" fill="#77b82a" /><path d="M46 54 C46 72, 22 76, 16 62 C12 52, 26 44, 46 54 Z" fill="#239be7" /><path d="M54 54 C54 72, 78 76, 84 62 C88 52, 74 44, 54 54 Z" fill="none" stroke="#e5a9b5" stroke-width="4" /></svg></div>
            <div class="logo-text"><h1 class="brand-title">MediSlot</h1><p>Cổng Lễ Tân</p></div>
        </div>
        <p>Hệ thống quản lý y tế MediSlot - Giải pháp toàn diện cho bệnh viện và phòng khám.</p>
        <p><strong>"MediSlot chúc quý khách và gia đình luôn có một sức khỏe dồi dào!"</strong></p>
    </div>
    <div><h4>Thông tin liên hệ</h4><p>Địa chỉ: Số 15, Phố Dịch Vọng Hậu, Quận Cầu Giấy, Hà Nội</p><p>Hotline: 1900 6868</p><p>Email: support@medislot.vn</p></div>
</footer>
<div class="modal-overlay" id="modal-overlay">
    <div class="modal-box">
        <h3 id="modal-title" style="margin:0 0 10px; color:var(--primary-blue);">Thông báo</h3>
        <p id="modal-message" style="font-size:13.5px; color:var(--text-gray); margin:0 0 18px;"></p>
        <div style="display:flex; justify-content:flex-end;"><button type="button" class="btn btn-primary" onclick="closeModal()">Đã hiểu</button></div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const urls = { updateProfile: '@urlUpdateProfile', changePassword: '@urlChangePassword' };
    let reloadAfterClose = false;

    function showAlert(title, msg, shouldReload = false) {
        reloadAfterClose = shouldReload;
        document.getElementById('modal-title').textContent = title;
        document.getElementById('modal-message').textContent = msg;
        document.getElementById('modal-overlay').classList.add('active');
    }
    window.closeModal = function () {
        document.getElementById('modal-overlay').classList.remove('active');
        if (reloadAfterClose) { reloadAfterClose = false; location.reload(); }
    };

    window.updateInfo = async function () {
        const headers = { 'Content-Type': 'application/json' };
        if (antiForgeryToken) headers['RequestVerificationToken'] = antiForgeryToken;
        try {
            const res = await fetch(urls.updateProfile, {
                method: 'PUT',
                headers,
                body: JSON.stringify({
                    fullname: document.getElementById('fullname').value.trim(),
                    phone: document.getElementById('phone').value.trim(),
                    address: document.getElementById('address').value.trim()
                })
            });
            const r = await res.json();
            if (res.ok && r.success !== false) showAlert('Cập nhật thành công', 'Thông tin cá nhân đã được lưu.', true);
            else showAlert('Cập nhật thất bại', r.detail || 'Không thể lưu thông tin.');
        } catch (e) { showAlert('Lỗi kết nối', 'Không thể kết nối đến máy chủ.'); }
    };

    window.changePassword = async function () {
        const curr = document.getElementById('current-pass').value, newP = document.getElementById('new-pass').value, conf = document.getElementById('confirm-pass').value;
        if (!curr || !newP || !conf) { showAlert('Thiếu thông tin', 'Vui lòng nhập đầy đủ các trường mật khẩu!'); return; }
        if (newP !== conf) { showAlert('Lỗi', 'Mật khẩu xác nhận mới không khớp!'); return; }
        if (newP.length < 6) { showAlert('Lỗi', 'Mật khẩu phải có ít nhất 6 ký tự!'); return; }

        const headers = { 'Content-Type': 'application/json' };
        if (antiForgeryToken) headers['RequestVerificationToken'] = antiForgeryToken;
        try {
            const res = await fetch(urls.changePassword, {
                method: 'POST',
                headers,
                body: JSON.stringify({ mat_khau_cu: curr, mat_khau_moi: newP })
            });
            const r = await res.json();
            if (res.ok && r.success !== false) {
                document.getElementById('passwordForm').reset();
                showAlert('Đổi mật khẩu thành công', 'Mật khẩu mới đã được cập nhật.');
            } else showAlert('Đổi mật khẩu thất bại', r.detail || 'Mật khẩu hiện tại không chính xác.');
        } catch (e) { showAlert('Lỗi kết nối', 'Không thể kết nối đến máy chủ.'); }
    };
</script>
</body>
</html>