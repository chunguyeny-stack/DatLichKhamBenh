<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediSlot</title>
    <link rel="icon" type="image/png" href="~/images/logo-medislot.png" />
    <style>
        body { font-family: Arial, sans-serif; background: #f8fafc; color: #0f172a; margin: 0; }
        header { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
        .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #0f172a; font-weight: 700; font-size: 18px; }
        .brand img { width: 34px; height: 34px; object-fit: contain; }
        nav a { margin-left: 16px; text-decoration: none; color: #334155; font-size: 14px; }
        nav a:hover { color: #2563eb; }
        main { max-width: 1160px; margin: 24px auto; padding: 0 16px; }
        .box { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px; margin-bottom: 16px; }
        .msg-ok { background: #ecfdf5; border: 1px solid #10b981; color: #065f46; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; }
        .msg-err { background: #fef2f2; border: 1px solid #ef4444; color: #991b1b; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; background: #fff; }
        th, td { border: 1px solid #e2e8f0; padding: 8px 10px; text-align: left; font-size: 13px; }
        th { background: #f1f5f9; }
        button, .btn { padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; cursor: pointer; font-size: 12px; text-decoration: none; color: #0f172a; display: inline-block; }
        .btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; }
    </style>
</head>
<body>
    <header>
        <a class="brand" href="@Url.Action("Index", "dashboard_le_tan", new { area = "Receptionist" })">
            <img src="~/images/logo-medislot.png" alt="MediSlot" />
            <span>MediSlot - Lễ tân</span>
        </a>
        <nav>
            <a href="@Url.Action("Index", "dashboard_le_tan", new { area = "Receptionist" })">Dashboard</a>
            <a href="@Url.Action("Index", "quan_ly_lich_hen_BN", new { area = "Receptionist" })">Lịch hẹn BN</a>
            <a href="@Url.Action("Index", "quan_ly_lich_lam_viec_BS", new { area = "Receptionist" })">Lịch làm việc BS</a>
            <a href="@Url.Action("Index", "vien_phi", new { area = "Receptionist" })">Thu viện phí</a>
        </nav>
    </header>
    <main>
        @if (TempData["Success"] != null)
        {
            <div class="msg-ok">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="msg-err">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>