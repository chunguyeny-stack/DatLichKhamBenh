@{
    Layout = null;
    string receptionistName = ViewBag.ReceptionistName ?? "Lễ tân";
    string initials = receptionistName.Trim().Length >= 2
        ? receptionistName.Trim().Substring(0, 2).ToUpper()
        : receptionistName.Trim().ToUpper();

    int tongLichHen = ViewBag.TongLichHen ?? 0;
    int daHoanThanh = ViewBag.DaHoanThanh ?? 0;
    int dangChoXuLy = ViewBag.DangChoXuLy ?? 0;
    int countSang = ViewBag.CountSang ?? 0;
    int countChieu = ViewBag.CountChieu ?? 0;
    int countToi = ViewBag.CountToi ?? 0;
    string cloverLogoUrl = Url.Content("~/static/images/logo-clover.png");

    string urlTongQuan = Url.Action("Index", "dashboard_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/dashboard_le_tan";
    string urlQuanLyLichHen = Url.Action("Index", "quan_ly_lich_hen_BN", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_hen_BN";
    string urlDanhSachCaTruc = Url.Action("Index", "quan_ly_lich_lam_viec_BS", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_lam_viec_BS";
    string urlVienPhi = Url.Action("Index", "vien_phi", new { area = "Receptionist" }) ?? "/Receptionist/vien_phi";
    string urlHoSoCaNhan = Url.Action("Index", "ho_so_ca_nhan_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/ho_so_ca_nhan_le_tan";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediSlot - Dashboard Lễ Tân</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/static/css/LT_BS.css" asp-append-version="true">
    <style>
        :root {
            --bg-body: #f4f7fb;
            --bg-card: #ffffff;
            --text-color: #1e293b;
            --text-gray: #64748b;
            --secondary-color: #0f172a;
            --border-color: #e2e8f0;
            --primary-blue: #2563eb;
            --primary-blue-light: #eff6ff;
            --primary-blue-soft: rgba(37, 99, 235, 0.08);
            --accent-purple: #7c3aed;
            --accent-red: #ef4444;
            --radius: 16px;
            --shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
            --shell-max: 1480px;
            --shell-pad: 24px;
        }
        html, body { max-width: 100%; overflow-x: hidden; margin: 0; font-family: 'Poppins', sans-serif; background: var(--bg-body); color: var(--text-color); }
        header {
            width: calc(100% - var(--shell-pad) * 2) !important; max-width: var(--shell-max) !important;
            margin: 10px auto 15px !important; padding: 10px 24px !important;
            display: flex !important; justify-content: space-between !important; align-items: center !important;
            flex-wrap: wrap !important; gap: 12px !important; background: var(--bg-card);
            border-radius: 14px !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); box-sizing: border-box !important;
        }
        .logo-container, .footer-logo { display: flex; align-items: center; gap: 12px; }
        .footer-logo { justify-content: center; }
        .brand-clover {
            width: 42px; height: 42px; border-radius: 12px; background: #fff;
            border: 1px solid var(--border-color); padding: 4px; box-sizing: border-box;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12); flex-shrink: 0; overflow: hidden;
        }
        .brand-clover img, .brand-clover svg { width: 100%; height: 100%; object-fit: contain; display: block; }
        .brand-title {
            margin: 0; font-size: 19px; font-weight: 700; letter-spacing: -0.3px; line-height: 1.15;
            background: linear-gradient(135deg, var(--primary-blue) 0%, #6366f1 55%, #ec4899 100%);
            -webkit-background-clip: text; background-clip: text; color: transparent;
        }
        .logo-text p { margin: 0; font-size: 11.5px; color: var(--text-gray); }
        header nav ul { display: flex !important; gap: 14px !important; align-items: center !important; flex-wrap: wrap !important; margin: 0 !important; padding: 0 !important; list-style: none !important; }
        header nav ul li a { font-size: 13.5px !important; font-weight: 500; white-space: nowrap !important; padding: 8px 12px !important; color: var(--text-color); text-decoration: none; border-radius: 8px; }
        header nav ul li a:hover { background: var(--primary-blue-soft); color: var(--primary-blue); }
        .header-right { display: flex !important; align-items: center !important; gap: 12px !important; flex-wrap: wrap !important; }
        .user-badge { display: flex; align-items: center; gap: 10px; cursor: pointer; white-space: nowrap !important; padding: 6px 14px !important; border-radius: 999px; background: var(--bg-body); border: 1px solid var(--border-color); }
        .user-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--primary-blue); color: #fff; font-weight: 600; font-size: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .user-name { font-size: 13.5px !important; font-weight: 600; max-width: 140px !important; overflow: hidden !important; text-overflow: ellipsis !important; }
        .user-role { font-size: 11px; color: var(--text-gray); }
        .logout-btn { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 16px; flex-shrink: 0; }
        .logout-btn:hover { background: #ef4444; color: #fff; }
        main { width: 100%; max-width: var(--shell-max); margin: 20px auto 80px; padding: 0 var(--shell-pad); box-sizing: border-box; }
        .welcome-banner {
            background: linear-gradient(135deg, var(--primary-blue), #6fb1f5); border-radius: var(--radius);
            padding: 30px 35px; color: #fff; margin-bottom: 30px; display: flex; justify-content: space-between;
            align-items: center; flex-wrap: wrap; gap: 20px; position: relative; overflow: hidden;
        }
        .welcome-banner h2 { color: #fff; font-size: clamp(20px, 2.2vw, 26px); margin: 0 0 8px; }
        .welcome-banner p { color: rgba(255, 255, 255, 0.9); font-size: 14px; margin: 0; }
        .welcome-time { background: rgba(255, 255, 255, 0.2); padding: 15px 25px; border-radius: 12px; text-align: right; }
        .welcome-time .time { font-size: 26px; font-weight: 700; line-height: 1; }
        .welcome-time .date { font-size: 12px; opacity: 0.9; margin-top: 5px; text-transform: uppercase; letter-spacing: 1px; }
        .stats-grid, .ca-truc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card, .ca-truc-card {
            background: var(--bg-card); border-radius: var(--radius); padding: 20px; border: 1px solid var(--border-color);
            box-shadow: var(--shadow); cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; min-width: 0;
        }
        .stat-card { display: flex; align-items: center; gap: 16px; }
        .stat-card:hover, .ca-truc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(37, 99, 235, 0.12); }
        .stat-icon { width: 50px; height: 50px; border-radius: 12px; background: var(--primary-blue-light); color: var(--primary-blue); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
        .stat-card.green .stat-icon { background: #dcfce7; color: #16a34a; }
        .stat-card.orange .stat-icon { background: #ffedd5; color: #ea580c; }
        .stat-info h4 { margin: 0 0 4px; font-size: clamp(18px, 1.5vw, 22px); font-weight: 700; }
        .stat-info p { margin: 0 0 6px; font-size: 13px; color: var(--text-gray); }
        .stat-info .trend { font-size: 11.5px; color: var(--primary-blue); font-weight: 500; }
        .stat-info .trend.down { color: #ea580c; }
        .ca-truc-card { padding: 24px; position: relative; overflow: hidden; }
        .ca-truc-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; }
        .ca-truc-card.sang::before { background: linear-gradient(90deg, #f39c12, #f8c471); }
        .ca-truc-card.chieu::before { background: linear-gradient(90deg, var(--primary-blue), #6fb1f5); }
        .ca-truc-card.toi::before { background: linear-gradient(90deg, var(--accent-purple), #bb8fce); }
        .ca-truc-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff; margin-bottom: 15px; }
        .ca-truc-card.sang .ca-truc-icon { background: linear-gradient(135deg, #f39c12, #f8c471); }
        .ca-truc-card.chieu .ca-truc-icon { background: linear-gradient(135deg, var(--primary-blue), #6fb1f5); }
        .ca-truc-card.toi .ca-truc-icon { background: linear-gradient(135deg, var(--accent-purple), #bb8fce); }
        .ca-truc-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
        .ca-truc-card h4 { font-size: 16px; margin: 0 0 5px; font-weight: 600; }
        .ca-truc-card .time-range { font-size: 12px; color: var(--text-gray); margin: 0; }
        .ca-truc-right { text-align: right; flex-shrink: 0; }
        .ca-truc-card .count { font-size: 32px; font-weight: 700; color: var(--primary-blue); line-height: 1; }
        .ca-truc-card.sang .count { color: #f39c12; }
        .ca-truc-card.toi .count { color: var(--accent-purple); }
        .ca-truc-card .count-label { font-size: 12px; color: var(--text-gray); margin-top: 4px; }
        footer {
            width: calc(100% - var(--shell-pad) * 2); max-width: var(--shell-max); margin: 40px auto 24px;
            padding: 28px; box-sizing: border-box; background: var(--bg-card); border-radius: var(--radius);
            border: 1px solid var(--border-color); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px; font-size: 13px; color: var(--text-gray); text-align: center;
        }
        footer > div { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        footer h4 { margin: 0 0 12px; color: var(--secondary-color); }
        body.is-narrow .stats-grid, body.is-narrow .ca-truc-grid { grid-template-columns: minmax(0, 1fr); }
        @@media (max-width: 992px) {
            .stats-grid, .ca-truc-grid { grid-template-columns: minmax(0, 1fr); }
            .welcome-banner { flex-direction: column; text-align: center; }
            .welcome-time { text-align: center; width: 100%; box-sizing: border-box; }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo-container">
            <div class="brand-clover">
                <img src="@cloverLogoUrl" alt="MediSlot" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                <svg viewBox="0 0 100 100" style="display:none;">
                    <path d="M46 46 C46 28, 22 24, 16 38 C12 48, 26 56, 46 46 Z" fill="#cfa0e3" />
                    <path d="M54 46 C54 28, 78 24, 84 38 C88 48, 74 56, 54 46 Z" fill="#77b82a" />
                    <path d="M46 54 C46 72, 22 76, 16 62 C12 52, 26 44, 46 54 Z" fill="#239be7" />
                    <path d="M54 54 C54 72, 78 76, 84 62 C88 52, 74 44, 54 54 Z" fill="none" stroke="#e5a9b5" stroke-width="4" />
                </svg>
            </div>
            <div class="logo-text">
                <h1 class="brand-title">MediSlot</h1>
                <p>Cổng Lễ Tân</p>
            </div>
        </div>
        <div class="header-right">
            <nav>
                <ul>
                    <li><a href="@urlTongQuan"><strong>Tổng quan</strong></a></li>
                    <li><a href="@urlQuanLyLichHen">Quản lý lịch hẹn</a></li>
                    <li><a href="@urlDanhSachCaTruc">Danh sách ca trực</a></li>
                    <li><a href="@urlVienPhi">Viện phí</a></li>
                </ul>
            </nav>
            <div class="user-badge" onclick="window.location.href='@urlHoSoCaNhan'" title="Hồ sơ cá nhân lễ tân">
                <div class="user-avatar">@initials</div>
                <div>
                    <div class="user-name">@receptionistName</div>
                    <div class="user-role">Lễ tân</div>
                </div>
            </div>
            <button type="button" class="logout-btn" onclick="window.location.href='/Account/Login'" title="Đăng xuất">
                <i class="fas fa-sign-out-alt"></i>
            </button>
        </div>
    </header>

    <main>
        <div class="welcome-banner">
            <div>
                <h2>Xin chào, @receptionistName! 👋</h2>
                <p>Chúc bạn một ngày làm việc hiệu quả. Đây là tổng quan ca trực hôm nay từ cơ sở dữ liệu.</p>
            </div>
            <div class="welcome-time">
                <div class="time" id="current-time">--:--</div>
                <div class="date" id="current-date">--/--/----</div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card" onclick="window.location.href='@urlQuanLyLichHen'">
                <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="stat-info">
                    <h4>@tongLichHen</h4>
                    <p>Tổng lịch hẹn hệ thống</p>
                    <div class="trend"><i class="fas fa-database"></i> Dữ liệu SQL Server</div>
                </div>
            </div>
            <div class="stat-card green" onclick="sessionStorage.setItem('initial_tab', 'checked'); window.location.href='@urlQuanLyLichHen'">
                <div class="stat-icon"><i class="fas fa-user-check"></i></div>
                <div class="stat-info">
                    <h4>@daHoanThanh</h4>
                    <p>Đã hoàn thành / Khám</p>
                    <div class="trend"><i class="fas fa-check"></i> Thời gian thực</div>
                </div>
            </div>
            <div class="stat-card orange" onclick="sessionStorage.setItem('initial_tab', 'pending'); window.location.href='@urlQuanLyLichHen'">
                <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
                <div class="stat-info">
                    <h4>@dangChoXuLy</h4>
                    <p>Đang chờ xác nhận / khám</p>
                    <div class="trend down"><i class="fas fa-clock"></i> Thời gian thực</div>
                </div>
            </div>
        </div>

        <h3 style="margin-bottom: 18px; font-size: 20px; color: var(--secondary-color);">
            <i class="fas fa-clock" style="color: var(--primary-blue);"></i> Thống kê phân loại ca trực
        </h3>

        <div class="ca-truc-grid">
            <div class="ca-truc-card sang" onclick="window.location.href='@urlDanhSachCaTruc'">
                <div class="ca-truc-icon"><i class="fas fa-sun"></i></div>
                <div class="ca-truc-row">
                    <div>
                        <h4>Ca Sáng</h4>
                        <p class="time-range"><i class="far fa-clock"></i> 07:30 - 11:30</p>
                    </div>
                    <div class="ca-truc-right">
                        <div class="count">@countSang</div>
                        <div class="count-label">bệnh nhân</div>
                    </div>
                </div>
            </div>
            <div class="ca-truc-card chieu" onclick="window.location.href='@urlDanhSachCaTruc'">
                <div class="ca-truc-icon"><i class="fas fa-cloud-sun"></i></div>
                <div class="ca-truc-row">
                    <div>
                        <h4>Ca Chiều</h4>
                        <p class="time-range"><i class="far fa-clock"></i> 13:30 - 18:30</p>
                    </div>
                    <div class="ca-truc-right">
                        <div class="count">@countChieu</div>
                        <div class="count-label">bệnh nhân</div>
                    </div>
                </div>
            </div>
            <div class="ca-truc-card toi" onclick="window.location.href='@urlDanhSachCaTruc'">
                <div class="ca-truc-icon"><i class="fas fa-moon"></i></div>
                <div class="ca-truc-row">
                    <div>
                        <h4>Ca Tối</h4>
                        <p class="time-range"><i class="far fa-clock"></i> 18:30 - 22:30 <span style="color: var(--accent-red); font-weight: 600;">(+10% phí)</span></p>
                    </div>
                    <div class="ca-truc-right">
                        <div class="count">@countToi</div>
                        <div class="count-label">bệnh nhân</div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div>
            <div class="footer-logo">
                <div class="brand-clover">
                    <img src="@cloverLogoUrl" alt="MediSlot" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                    <svg viewBox="0 0 100 100" style="display:none;">
                        <path d="M46 46 C46 28, 22 24, 16 38 C12 48, 26 56, 46 46 Z" fill="#cfa0e3" />
                        <path d="M54 46 C54 28, 78 24, 84 38 C88 48, 74 56, 54 46 Z" fill="#77b82a" />
                        <path d="M46 54 C46 72, 22 76, 16 62 C12 52, 26 44, 46 54 Z" fill="#239be7" />
                        <path d="M54 54 C54 72, 78 76, 84 62 C88 52, 74 44, 54 54 Z" fill="none" stroke="#e5a9b5" stroke-width="4" />
                    </svg>
                </div>
                <div class="logo-text">
                    <h1 class="brand-title">MediSlot</h1>
                    <p>Cổng Lễ Tân</p>
                </div>
            </div>
            <p>Hệ thống quản lý y tế MediSlot - Giải pháp toàn diện cho bệnh viện và phòng khám.</p>
            <p><strong>"MediSlot chúc quý khách và gia đình luôn có một sức khỏe dồi dào!"</strong></p>
        </div>
        <div>
            <h4>Thông tin liên hệ</h4>
            <p>Địa chỉ: Số 15, Phố Dịch Vọng Hậu, Quận Cầu Giấy, Hà Nội</p>
            <p>Hotline: 1900 6868</p>
            <p>Email: support@medislot.vn</p>
        </div>
    </footer>

    <script>
        function syncViewportLayout() {
            document.body.classList.toggle('is-narrow', window.innerWidth < 1180);
        }
        window.addEventListener('resize', syncViewportLayout);
        if (typeof ResizeObserver !== 'undefined') new ResizeObserver(syncViewportLayout).observe(document.body);
        syncViewportLayout();

        function updateTime() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const mo = String(now.getMonth() + 1).padStart(2, '0');
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            document.getElementById('current-time').textContent = `${hh}:${mm}`;
            document.getElementById('current-date').textContent = `${days[now.getDay()]}, ${dd}/${mo}/${now.getFullYear()}`;
        }
        updateTime();
        setInterval(updateTime, 60000);
    </script>
</body>
</html>