@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using DatLichKhamBenh.Models.Entities
@model IEnumerable<Appointment>
@{
    Layout = null;
    string receptionistName = ViewBag.ReceptionistName ?? "Lễ tân";
    string initials = receptionistName.Trim().Length >= 2
        ? receptionistName.Trim().Substring(0, 2).ToUpper()
        : receptionistName.Trim().ToUpper();
    string cloverLogoUrl = Url.Content("~/images/logo.png");
    string urlHoSoCaNhan = Url.Action("Index", "ho_so_ca_nhan_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/ho_so_ca_nhan_le_tan";
    var sdtBnMap = ViewBag.SoDienThoaiBenhNhanMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var appointmentsList = Model?.ToList() ?? new List<Appointment>();

    string urlTongQuan = Url.Action("Index", "dashboard_le_tan", new { area = "Receptionist" }) ?? "/Receptionist/dashboard_le_tan";
    string urlQuanLyLichHen = Url.Action("Index", "quan_ly_lich_hen_BN", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_hen_BN";
    string urlDanhSachCaTruc = Url.Action("Index", "quan_ly_lich_lam_viec_BS", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_lam_viec_BS";
    string urlVienPhi = Url.Action("Index", "vien_phi", new { area = "Receptionist" }) ?? "/Receptionist/vien_phi";
    string urlConfirm = Url.Action("Confirm", "quan_ly_lich_hen_BN", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_hen_BN/Confirm";
    string urlCheckIn = Url.Action("CheckIn", "quan_ly_lich_hen_BN", new { area = "Receptionist" }) ?? "/Receptionist/quan_ly_lich_hen_BN/CheckIn";

    string tempSuccess = TempData["Success"]?.ToString() ?? "";
    string tempError = TempData["Error"]?.ToString() ?? "";

    var serializedAppts = appointmentsList.Select(a =>
    {
        bool isExpiredDate = a.AppointmentDate.Date < DateTime.Today;
        var rawStatusTrim = (a.Status ?? "Chờ").Trim();
        var lowerCheck = rawStatusTrim.ToLower();

        bool isCancelledByStatus = lowerCheck.Contains("hủy") || lowerCheck.Contains("cancel") || lowerCheck.Contains("không đến") || lowerCheck.Contains("no-show") || lowerCheck.Contains("no show");
        bool isCheckedOrDone = lowerCheck.Contains("check-in") || lowerCheck.Contains("checked") || lowerCheck.Contains("hoàn thành") || lowerCheck.Contains("completed") || lowerCheck.Contains("đã đến") || lowerCheck.Contains("đã thanh toán");
        bool isConfirmed = lowerCheck.Contains("đã xác nhận") || lowerCheck.Contains("confirmed");

        string stCode = isCancelledByStatus || (isExpiredDate && !isCheckedOrDone)
            ? "cancelled"
            : (isCheckedOrDone ? "checked" : (isConfirmed ? "confirmed" : "pending"));
        string stRaw = stCode == "cancelled"
            ? "Đã hủy"
            : (stCode == "confirmed" ? "Đã xác nhận" : rawStatusTrim);

        var slot = (a.TimeSlot ?? "08:00-08:30").Trim();
        var hourPart = slot.Split('-', ':')[0].Trim();
        int startHour = int.TryParse(hourPart, out var h) ? h : 8;
        string caCode = startHour >= 18 ? "toi" : (startHour >= 12 ? "chieu" : "sang");

        string bnPhone = sdtBnMap.TryGetValue(a.Id, out var p) && !string.IsNullOrWhiteSpace(p)
            ? p
            : (!string.IsNullOrWhiteSpace(a.Patient?.PhoneNumber) ? a.Patient!.PhoneNumber! : "Chưa có SĐT");

        string noteText = !string.IsNullOrWhiteSpace(a.Notes)
            ? a.Notes!
            : (!string.IsNullOrWhiteSpace(a.Symptoms) ? a.Symptoms! : "Khám tổng quát định kỳ");

        if (stCode == "cancelled" && isExpiredDate && !noteText.Contains("quá ngày khám"))
            noteText += " (Tự động hủy do quá ngày khám)";

        string doctorDisplayName = !string.IsNullOrWhiteSpace(a.Doctor?.FullName)
            ? a.Doctor!.FullName
            : (!string.IsNullOrWhiteSpace(a.Doctor?.User?.FullName) ? a.Doctor!.User!.FullName : $"BS #{a.DoctorId}");

        return new
        {
            id = $"LH{a.Id:D3}",
            rawId = a.Id,
            phone = bnPhone,
            date = a.AppointmentDate.ToString("yyyy-MM-dd"),
            dateDisplay = a.AppointmentDate.ToString("dd/MM/yyyy"),
            time = slot,
            ca = caCode,
            doctor = doctorDisplayName,
            doctorId = a.DoctorId,
            symptom = noteText,
            status = stCode,
            statusRaw = stRaw,
            trieu_chung_thuc_the = a.Symptoms ?? "",
            chan_doan = "",
            loi_dan = "",
            don_thuoc = ""
        };
    }).ToList();

    var doctorsDistinct = serializedAppts
        .Where(x => x.doctorId > 0)
        .GroupBy(x => x.doctorId)
        .Select(g => new { id = g.Key, name = g.First().doctor })
        .ToList();

    string apptsJson = JsonSerializer.Serialize(serializedAppts);
    string doctorsJson = JsonSerializer.Serialize(doctorsDistinct);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediSlot - Quản lý Lịch hẹn</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/LT_BS.css" asp-append-version="true">
    <style>
        :root {
            --bg-body: #f4f7fb;
            --bg-card: #ffffff;
            --text-color: #1e293b;
            --text-gray: #64748b;
            --secondary-color: #0f172a;
            --border-color: #e2e8f0;
            --primary-blue: #2563eb;
            --primary-blue-light: #eff6ff;
            --primary-blue-soft: rgba(37, 99, 235, 0.08);
            --accent-green: #10b981;
            --accent-orange: #f59e0b;
            --accent-red: #ef4444;
            --radius: 16px;
            --shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
            --shell-max: 1480px;
            --shell-pad: 24px;
        }

        html, body {
            max-width: 100%;
            overflow-x: hidden;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #f4f7fb;
            color: #1e293b;
        }

        header {
            width: calc(100% - 48px);
            max-width: 1480px;
            margin: 10px auto 15px;
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            box-sizing: border-box;
        }

        .logo-container, .footer-logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .footer-logo { justify-content: center; }

        .brand-clover {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid #e2e8f0;
            padding: 4px;
            box-sizing: border-box;
            flex-shrink: 0;
            overflow: hidden;
        }

        .brand-clover img, .brand-clover svg {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .brand-title {
            margin: 0;
            font-size: 19px;
            font-weight: 700;
            line-height: 1.15;
            background: linear-gradient(135deg, #2563eb 0%, #6366f1 55%, #ec4899 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .logo-text p { margin: 0; font-size: 11.5px; color: #64748b; }

        header nav ul {
            display: flex;
            gap: 14px;
            align-items: center;
            flex-wrap: wrap;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        header nav ul li a {
            font-size: 13.5px;
            font-weight: 500;
            white-space: nowrap;
            padding: 8px 12px;
            color: #1e293b;
            text-decoration: none;
            border-radius: 8px;
        }

        header nav ul li a:hover { background: rgba(37, 99, 235, 0.08); color: #2563eb; }

        .header-right, .user-badge { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

        .user-badge {
            cursor: pointer;
            white-space: nowrap;
            padding: 6px 14px;
            border-radius: 999px;
            background: #f4f7fb;
            border: 1px solid #e2e8f0;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #2563eb;
            color: #fff;
            font-weight: 600;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .user-name { font-size: 13.5px; font-weight: 600; max-width: 140px; overflow: hidden; text-overflow: ellipsis; }
        .user-role { font-size: 11px; color: #64748b; }

        .logout-btn {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ef4444;
            font-size: 16px;
        }

        .logout-btn:hover { background: #ef4444; color: #fff; }

        main { width: 100%; max-width: 1480px; margin: 16px auto 70px; padding: 0 24px; box-sizing: border-box; }

        .top-breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748b; margin-bottom: 14px; }
        .top-breadcrumb a { color: #2563eb; text-decoration: none; font-weight: 500; }
        .page-header-row h2 { margin: 0 0 18px; font-size: 24px; color: #0f172a; }

        .btn-clean {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #1e293b;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

        .btn-clean:hover:not(:disabled) { border-color: #2563eb; color: #2563eb; background: #eff6ff; }
        .btn-clean:disabled { opacity: 0.45; cursor: not-allowed; }
        .btn-primary-clean { background: #2563eb; color: #fff; border-color: #2563eb; }
        .btn-primary-clean:hover:not(:disabled) { background: #1d4ed8; color: #fff; }
        .btn-sm-clean { padding: 7px 12px; font-size: 12px; }

        .toast-alert { padding: 12px 16px; border-radius: 12px; margin-bottom: 18px; font-size: 13.5px; font-weight: 500; }
        .toast-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .toast-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

        .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 22px; }
        .stat-card {
            background: #ffffff;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            min-width: 0;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .stat-card.green .stat-icon { background: #dcfce7; color: #16a34a; }
        .stat-card.orange .stat-icon { background: #ffedd5; color: #ea580c; }
        .stat-card.red .stat-icon { background: #fee2e2; color: #ef4444; }
        .stat-info h4 { margin: 0 0 3px; font-size: 22px; font-weight: 700; }
        .stat-info p { margin: 0; font-size: 13px; color: #64748b; }

        .date-picker-box, .filter-panel {
            background: #ffffff;
            border-radius: 16px;
            padding: 16px 20px;
            box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
            border: 1px solid #e2e8f0;
            margin-bottom: 18px;
        }

        .date-picker-box { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .date-picker-box label { font-weight: 600; font-size: 13.5px; color: #0f172a; display: flex; align-items: center; gap: 8px; }
        .date-picker-box input[type="date"] {
            padding: 8px 14px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            background: #f4f7fb;
            color: #1e293b;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
        }

        .filter-panel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 16px; align-items: end; }
        .filter-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        .filter-field label { display: block; font-size: 12.5px; font-weight: 600; color: #0f172a; }
        .filter-field select, .filter-field input[type="text"] {
            width: 100%;
            height: 40px;
            padding: 0 12px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            background: #f4f7fb;
            color: #1e293b;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            box-sizing: border-box;
        }

        .search-box { position: relative; }
        .search-box i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 13px; }
        .search-box input[type="text"] { padding-left: 36px; }

        .tabs-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
        .tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #1e293b;
            font-family: 'Poppins', sans-serif;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
        }

        .tab-btn.active { background: #2563eb; color: #fff; border-color: #2563eb; }
        .tab-btn .badge-num { background: rgba(15, 23, 42, 0.08); padding: 1px 7px; border-radius: 999px; font-size: 11.5px; font-weight: 600; }
        .tab-btn.active .badge-num { background: rgba(255, 255, 255, 0.25); color: #fff; }

        .appointment-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 18px 22px;
            box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
            border: 1px solid #e2e8f0;
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 18px;
            align-items: center;
            margin-bottom: 12px;
            position: relative;
            overflow: hidden;
        }

        .appointment-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #2563eb; }
        .appointment-card[data-status="pending"]::before { background: #f59e0b; }
        .appointment-card[data-status="checked"]::before { background: #10b981; }
        .appointment-card[data-status="cancelled"]::before { background: #ef4444; }

        .appt-time-box { text-align: center; padding: 12px 14px; background: #eff6ff; border-radius: 12px; min-width: 92px; }
        .appt-time-box .time { font-size: 18px; font-weight: 700; color: #2563eb; line-height: 1.2; }
        .appt-time-box .ca { font-size: 10.5px; color: #64748b; margin-top: 4px; font-weight: 600; text-transform: uppercase; }

        .appt-info h4 { margin: 0 0 6px; font-size: 16px; font-weight: 700; color: #0f172a; }
        .appt-meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: #64748b; margin-bottom: 8px; }
        .appt-meta span { display: inline-flex; align-items: center; gap: 5px; }
        .appt-meta i { color: #2563eb; }
        .appt-note { font-size: 12.5px; color: #64748b; background: #f4f7fb; padding: 7px 12px; border-radius: 8px; }

        .appt-actions { display: flex; flex-direction: column; gap: 7px; min-width: 145px; align-items: stretch; }
        .status-pill { display: inline-flex; justify-content: center; padding: 4px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600; background: #fef3c7; color: #b45309; }
        .status-pill.confirmed { background: #dbeafe; color: #1d4ed8; }
        .status-pill.checked { background: #dcfce7; color: #15803d; }
        .status-pill.cancelled { background: #fee2e2; color: #b91c1c; }

        .pagination-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 18px;
            padding: 14px 18px;
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
            font-size: 13px;
            color: #64748b;
        }

        .pagination-btns { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .page-num-btn {
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #1e293b;
            font-family: 'Poppins', sans-serif;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
        }

        .page-num-btn.active { background: #2563eb; color: #fff; border-color: #2563eb; }

        .empty-state {
            text-align: center;
            padding: 64px 20px;
            color: #64748b;
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 16px;
        }

        .modal-overlay.active { display: flex; }
        .modal-box {
            background: #ffffff;
            color: #1e293b;
            padding: 24px;
            border-radius: 16px;
            max-width: 740px;
            width: 100%;
            max-height: 86vh;
            overflow-y: auto;
        }

        .record-section { margin-bottom: 14px; background: #f4f7fb; padding: 12px 15px; border-radius: 10px; }
        .record-section h5 { margin: 0 0 6px; font-size: 12.5px; color: #2563eb; text-transform: uppercase; }
        .record-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 6px; }
        .record-table th, .record-table td { border: 1px solid #e2e8f0; padding: 8px 10px; text-align: left; }
        .record-table th { background: #eff6ff; color: #2563eb; }

        footer { display: none !important; }
        .legacy-footer { 
            width: calc(100% - 48px);
            max-width: 1480px;
            margin: 36px auto 24px;
            padding: 28px;
            box-sizing: border-box;
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
            font-size: 13px;
            color: #64748b;
            text-align: center;
        }

        footer > div { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        footer h4 { margin: 0 0 12px; color: #0f172a; }

        body.is-narrow .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        body.is-narrow .filter-panel { grid-template-columns: 1fr; }

        @@media (max-width: 1100px) {
            .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .filter-panel { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 820px) {
            .stats-grid { grid-template-columns: 1fr; }
            .filter-panel { grid-template-columns: 1fr; }
            .appointment-card { grid-template-columns: auto 1fr; }
            .appt-actions { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; min-width: unset; }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo-container">
            <div class="brand-clover">
                <img src="@cloverLogoUrl" alt="MediSlot" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                <svg viewBox="0 0 100 100" style="display:none;">
                    <path d="M46 46 C46 28, 22 24, 16 38 C12 48, 26 56, 46 46 Z" fill="#cfa0e3" />
                    <path d="M54 46 C54 28, 78 24, 84 38 C88 48, 74 56, 54 46 Z" fill="#77b82a" />
                    <path d="M46 54 C46 72, 22 76, 16 62 C12 52, 26 44, 46 54 Z" fill="#239be7" />
                    <path d="M54 54 C54 72, 78 76, 84 62 C88 52, 74 44, 54 54 Z" fill="none" stroke="#e5a9b5" stroke-width="4" />
                </svg>
            </div>
            <div class="logo-text">
                <h1 class="brand-title">MediSlot</h1>
                <p>Cổng Lễ Tân</p>
            </div>
        </div>
        <div class="header-right">
            <nav>
                <ul>
                    <li><a href="@urlTongQuan">Tổng quan</a></li>
                    <li><a href="@urlQuanLyLichHen"><strong>Quản lý lịch hẹn</strong></a></li>
                    <li><a href="@urlDanhSachCaTruc">Danh sách ca trực</a></li>
                    <li><a href="@urlVienPhi">Viện phí</a></li>
                </ul>
            </nav>
            <div class="user-badge" onclick="window.location.href='@urlHoSoCaNhan'" title="Hồ sơ cá nhân lễ tân">
                <div class="user-avatar">@initials</div>
                <div>
                    <div class="user-name">@receptionistName</div>
                    <div class="user-role">Lễ tân</div>
                </div>
            </div>
            <form action="/Account/Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
            <button type="submit" class="logout-btn" title="Đăng xuất">
                <i class="fas fa-sign-out-alt"></i>
            </button>
            </form>
        </div>
    </header>

    <main>
        <div class="top-breadcrumb">
            <a href="@urlTongQuan"><i class="fas fa-home"></i> Tổng quan</a>
            <span>/</span>
            <span>Quản lý lịch hẹn</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(tempSuccess))
        {
            <div class="toast-alert toast-success"><i class="fas fa-check-circle"></i> @tempSuccess</div>
        }
        @if (!string.IsNullOrWhiteSpace(tempError))
        {
            <div class="toast-alert toast-error"><i class="fas fa-exclamation-circle"></i> @tempError</div>
        }

        <div class="page-header-row">
            <h2><i class="fas fa-calendar-alt" style="color: #2563eb;"></i> Quản lý Lịch hẹn</h2>
        </div>

        <div class="stats-grid">
            <div class="stat-card orange" onclick="switchTab('pending')">
                <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
                <div class="stat-info"><h4 id="stat-pending">0</h4><p>Chờ xác nhận</p></div>
            </div>
            <div class="stat-card" onclick="switchTab('confirmed')">
                <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                <div class="stat-info"><h4 id="stat-confirmed">0</h4><p>Đã xác nhận</p></div>
            </div>
            <div class="stat-card green" onclick="switchTab('checked')">
                <div class="stat-icon"><i class="fas fa-user-check"></i></div>
                <div class="stat-info"><h4 id="stat-checked">0</h4><p>Đã check-in / Khám</p></div>
            </div>
            <div class="stat-card red" onclick="switchTab('cancelled')">
                <div class="stat-icon"><i class="fas fa-ban"></i></div>
                <div class="stat-info"><h4 id="stat-cancelled" style="color: #ef4444;">0</h4><p>Đã hủy</p></div>
            </div>
        </div>

        <div class="date-picker-box">
            <label for="filter-specific-date"><i class="fas fa-calendar-day" style="color: #2563eb;"></i> Chọn ngày tìm kiếm:</label>
            <input type="date" id="filter-specific-date" onchange="applyDateFilter()">
            <button type="button" class="btn-clean btn-sm-clean" onclick="clearDateFilter()"><i class="fas fa-redo"></i> Xem tất cả ngày</button>
        </div>

        <div class="filter-panel">
            <div class="filter-field">
                <label for="filter-ca">Ca trực</label>
                <select id="filter-ca" onchange="applyFilter()">
                    <option value="">-- Tất cả ca --</option>
                    <option value="sang">Ca sáng (07:30 - 11:30)</option>
                    <option value="chieu">Ca chiều (13:30 - 18:30)</option>
                    <option value="toi">Ca tối (18:30 - 22:30)</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="filter-doctor">Bác sĩ</label>
                <select id="filter-doctor" onchange="applyFilter()">
                    <option value="">-- Tất cả bác sĩ --</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="filter-keyword">Tìm kiếm</label>
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="filter-keyword" placeholder="Mã lịch hẹn, SĐT..." oninput="applyFilter()">
                </div>
            </div>
            <div class="filter-field">
                <label>&nbsp;</label>
                <button type="button" class="btn-clean" onclick="resetFilter()"><i class="fas fa-redo"></i> Đặt lại</button>
            </div>
        </div>

        <div class="tabs-row">
            <button type="button" class="tab-btn active" data-filter="all" onclick="switchTab('all')"><i class="fas fa-list"></i> Tất cả <span class="badge-num" id="count-all">0</span></button>
            <button type="button" class="tab-btn" data-filter="pending" onclick="switchTab('pending')"><i class="fas fa-hourglass-half"></i> Chờ xác nhận <span class="badge-num" id="count-pending">0</span></button>
            <button type="button" class="tab-btn" data-filter="confirmed" onclick="switchTab('confirmed')"><i class="fas fa-check-circle"></i> Đã xác nhận <span class="badge-num" id="count-confirmed">0</span></button>
            <button type="button" class="tab-btn" data-filter="checked" onclick="switchTab('checked')"><i class="fas fa-user-check"></i> Đã check-in <span class="badge-num" id="count-checked">0</span></button>
            <button type="button" class="tab-btn" data-filter="cancelled" onclick="switchTab('cancelled')"><i class="fas fa-ban"></i> Đã hủy <span class="badge-num" id="count-cancelled">0</span></button>
        </div>

        <div id="appointments-list"></div>
        <div id="pagination-container"></div>
    </main>


    <div class="modal-overlay" id="modal-overlay">
        <div class="modal-box" id="modal-content-box"></div>
    </div>
    <form id="post-action-form" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="post-action-id" />
    </form>

    <script>
        function syncViewportLayout() { document.body.classList.toggle('is-narrow', window.innerWidth < 1180); }
        window.addEventListener('resize', syncViewportLayout);
        if (typeof ResizeObserver !== 'undefined') new ResizeObserver(syncViewportLayout).observe(document.body);
        syncViewportLayout();

        const now = new Date();
        const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
        const appointments = (@Html.Raw(apptsJson)).map(a => (a.date && a.date < todayIso && a.status !== 'checked' && a.status !== 'cancelled')
            ? { ...a, status: 'cancelled', statusRaw: 'Đã hủy', symptom: a.symptom.includes('quá ngày khám') ? a.symptom : `${a.symptom} (Tự động hủy do quá ngày khám)` }
            : a);
        const doctorsList = @Html.Raw(doctorsJson);
        const actionUrls = { Confirm: '@urlConfirm', CheckIn: '@urlCheckIn' };
        const caLabels = { sang: 'Ca sáng', chieu: 'Ca chiều', toi: 'Ca tối' };
        const PAGE_SIZE = 6;

        const doctorSelect = document.getElementById('filter-doctor');
        if (doctorSelect && Array.isArray(doctorsList)) {
            doctorSelect.innerHTML = '<option value="">-- Tất cả bác sĩ --</option>' + doctorsList.map(d => `<option value="${d.id}">${d.name}</option>`).join('');
        }

        let currentTab = 'all', selectedDateFilter = '', currentPage = 1, currentFilterData = { ca: '', doctorId: '', keyword: '' };
        const modalOverlay = document.getElementById('modal-overlay'), modalContentBox = document.getElementById('modal-content-box');
        window.closeModal = function () {
            modalOverlay.classList.remove('active');
            modalContentBox.innerHTML = '';
        };
        modalOverlay.addEventListener('click', e => { if (e.target === modalOverlay) closeModal(); });

        window.showMedicalRecordModal = function (rawId) {
            const appt = appointments.find(a => String(a.rawId) === String(rawId));
            if (!appt) return;
            let meds = [];
            try { if (typeof appt.don_thuoc === 'string' && appt.don_thuoc.trim()) meds = JSON.parse(appt.don_thuoc); } catch (e) { }
            const medRows = Array.isArray(meds) && meds.length
                ? meds.map((m, i) => `<tr><td>${i + 1}</td><td><strong>${m.name || m.ten || 'Thuốc điều trị'}</strong></td><td>${m.dose || m.lieu_luong || 'Theo chỉ định'}</td><td>${m.qty || m.so_luong || 1}</td></tr>`).join('')
                : `<tr><td colspan="4" style="text-align:center; color:#64748b;">Không có đơn thuốc chi tiết trong ca khám này.</td></tr>`;
            modalContentBox.innerHTML = `
                <div style="text-align:center; border-bottom:2px solid #e2e8f0; padding-bottom:12px; margin-bottom:16px;">
                    <h3 style="margin:0; color:#2563eb;">PHIẾU KHÁM BỆNH & HỒ SƠ BỆNH ÁN</h3>
                    <p style="margin:4px 0 0; font-size:12px; color:#64748b;">MediSlot • Mã LH: <strong>${appt.id}</strong> • Ngày: ${appt.dateDisplay} (${appt.time})</p>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px; font-size:13px;">
                    <div><strong>Mã lịch hẹn:</strong> ${appt.id}</div>
                    <div><strong>SĐT:</strong> ${appt.phone}</div>
                    <div><strong>Bác sĩ:</strong> ${appt.doctor}</div>
                    <div><strong>Ghi chú:</strong> ${appt.symptom}</div>
                </div>
                <div class="record-section"><h5>Triệu chứng thực thể / Khám lâm sàng</h5><p style="margin:0; font-size:13px;">${appt.trieu_chung_thuc_the || 'Chưa ghi nhận.'}</p></div>
                <div class="record-section"><h5>Chẩn đoán của bác sĩ</h5><p style="margin:0; font-size:13px; font-weight:600; color:#ef4444;">${appt.chan_doan || 'Chưa có chẩn đoán.'}</p></div>
                <div class="record-section"><h5>Đơn thuốc điều trị</h5><table class="record-table"><thead><tr><th>STT</th><th>Tên thuốc</th><th>Cách dùng</th><th>SL</th></tr></thead><tbody>${medRows}</tbody></table></div>
                <div class="record-section"><h5>Lời dặn của bác sĩ</h5><p style="margin:0; font-size:13px;">${appt.loi_dan || 'Không có ghi chú thêm.'}</p></div>
                <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:16px;">
                    <button type="button" class="btn-clean" onclick="closeModal()">Đóng</button>
                    <button type="button" class="btn-clean btn-primary-clean" onclick="window.print()"><i class="fas fa-print"></i> In phiếu</button>
                </div>`;
            modalOverlay.classList.add('active');
        };

        window.submitAction = function (actionName, id) {
            const form = document.getElementById('post-action-form'), idInput = document.getElementById('post-action-id');
            if (!form || !idInput) return;
            form.action = actionUrls[actionName] || `${'@urlQuanLyLichHen'.replace(/\/Index$/i, '')}/${actionName}`;
            idInput.value = String(id);
            form.submit();
        };

        window.goToPage = function (p) { currentPage = p; renderAppointments(); };
        window.applyDateFilter = function () { selectedDateFilter = document.getElementById('filter-specific-date').value; currentPage = 1; renderAppointments(); };
        window.clearDateFilter = function () { document.getElementById('filter-specific-date').value = ''; selectedDateFilter = ''; currentPage = 1; renderAppointments(); };

        function updateStats(filtered) {
            const data = filtered || appointments;
            const counts = {
                pending: data.filter(a => a.status === 'pending').length,
                confirmed: data.filter(a => a.status === 'confirmed').length,
                checked: data.filter(a => a.status === 'checked').length,
                cancelled: data.filter(a => a.status === 'cancelled').length
            };
            ['pending', 'confirmed', 'checked', 'cancelled'].forEach(k => {
                document.getElementById(`stat-${k}`).textContent = counts[k];
                document.getElementById(`count-${k}`).textContent = counts[k];
            });
            document.getElementById('count-all').textContent = data.length;
        }

        function renderPagination(totalItems) {
            const pg = document.getElementById('pagination-container');
            if (!totalItems) { pg.innerHTML = ''; return; }
            const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
            if (currentPage > totalPages) currentPage = totalPages;
            const startIdx = (currentPage - 1) * PAGE_SIZE + 1;
            const endIdx = Math.min(totalItems, currentPage * PAGE_SIZE);

            let nums = '';
            for (let i = 1; i <= totalPages; i++) {
                nums += `<button type="button" class="page-num-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
            }
            pg.innerHTML = `
                <div class="pagination-bar">
                    <span>Hiển thị <b>${startIdx}–${endIdx}</b> / <b>${totalItems}</b> lịch hẹn (6 / trang)</span>
                    <div class="pagination-btns">
                        <button type="button" class="btn-clean btn-sm-clean" ${currentPage <= 1 ? 'disabled' : ''} onclick="goToPage(${currentPage - 1})"><i class="fas fa-chevron-left"></i> Trước</button>
                        ${nums}
                        <button type="button" class="btn-clean btn-sm-clean" ${currentPage >= totalPages ? 'disabled' : ''} onclick="goToPage(${currentPage + 1})">Sau <i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>`;
        }

        function renderAppointments() {
            const list = document.getElementById('appointments-list');
            let filtered = [...appointments];
            if (currentTab !== 'all') filtered = filtered.filter(a => a.status === currentTab);
            if (currentFilterData.ca) filtered = filtered.filter(a => a.ca === currentFilterData.ca);
            if (currentFilterData.doctorId) filtered = filtered.filter(a => String(a.doctorId) === String(currentFilterData.doctorId));
            if (currentFilterData.keyword) {
                const kw = currentFilterData.keyword.toLowerCase();
                filtered = filtered.filter(a => a.id.toLowerCase().includes(kw) || a.phone.toLowerCase().includes(kw));
            }
            if (selectedDateFilter) filtered = filtered.filter(a => a.date === selectedDateFilter);
            updateStats(filtered);

            if (!filtered.length) {
                list.innerHTML = `<div class="empty-state"><i class="fas fa-calendar-times" style="font-size:52px; opacity:.35;"></i><h3>Không có lịch hẹn nào từ cơ sở dữ liệu</h3><p>Thử thay đổi bộ lọc hoặc chọn ngày khác để xem kết quả.</p></div>`;
                renderPagination(0);
                return;
            }

            const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
            if (currentPage > totalPages) currentPage = totalPages;
            const start = (currentPage - 1) * PAGE_SIZE;
            const shown = filtered.slice(start, start + PAGE_SIZE);

            list.innerHTML = shown.map(appt => {
                let actionsHTML = '';
                if (appt.status === 'checked') {
                    actionsHTML = `<span class="status-pill checked">${appt.statusRaw || 'Đã check-in'}</span><button type="button" class="btn-clean btn-sm-clean" onclick="showMedicalRecordModal('${appt.rawId}')"><i class="fas fa-file-medical"></i> Hồ sơ bệnh án</button>`;
                } else if (appt.status === 'cancelled') {
                    actionsHTML = `<span class="status-pill cancelled">${appt.statusRaw || 'Đã hủy'}</span>`;
                } else if (appt.status === 'confirmed') {
                    actionsHTML = `<span class="status-pill confirmed">Đã xác nhận</span><button type="button" class="btn-clean btn-sm-clean" onclick="submitAction('CheckIn', '${appt.rawId}')"><i class="fas fa-user-check"></i> Đã đến</button>`;
                } else {
                    actionsHTML = `<span class="status-pill">${appt.statusRaw || 'Chờ xác nhận'}</span><button type="button" class="btn-clean btn-primary-clean btn-sm-clean" onclick="submitAction('Confirm', '${appt.rawId}')"><i class="fas fa-check"></i> Xác nhận</button><button type="button" class="btn-clean btn-sm-clean" onclick="submitAction('CheckIn', '${appt.rawId}')"><i class="fas fa-user-check"></i> Đã đến</button>`;
                }
                return `<div class="appointment-card" data-status="${appt.status}" id="appt-card-${appt.rawId}"><div class="appt-time-box"><div class="time">${appt.time.split('-')[0].trim()}</div><div class="ca">${caLabels[appt.ca] || 'Ca khám'}</div></div><div class="appt-info"><h4>${appt.id}</h4><div class="appt-meta"><span><i class="fas fa-user-md"></i> ${appt.doctor}</span><span><i class="fas fa-phone"></i> ${appt.phone}</span><span><i class="fas fa-calendar"></i> ${appt.dateDisplay} (${appt.time})</span></div><div class="appt-note"><i class="fas fa-notes-medical"></i> ${appt.symptom}</div></div><div class="appt-actions">${actionsHTML}</div></div>`;
            }).join('');
            renderPagination(filtered.length);
        }

        window.switchTab = function (filter) {
            currentTab = filter; currentPage = 1;
            document.querySelectorAll('.tab-btn').forEach(t => t.classList.toggle('active', t.dataset.filter === filter));
            renderAppointments();
        };
        window.applyFilter = function () {
            currentFilterData = { ca: document.getElementById('filter-ca').value, doctorId: document.getElementById('filter-doctor').value, keyword: document.getElementById('filter-keyword').value.trim() };
            currentPage = 1; renderAppointments();
        };
        window.resetFilter = function () {
            document.getElementById('filter-ca').value = ''; document.getElementById('filter-doctor').value = ''; document.getElementById('filter-keyword').value = '';
            currentFilterData = { ca: '', doctorId: '', keyword: '' }; currentPage = 1; clearDateFilter();
        };
        switchTab(currentTab);
    </script>
</body>
</html>