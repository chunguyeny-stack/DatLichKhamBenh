@model IEnumerable<DatLichKhamBenh.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Nhật ký hoạt động";
}
<section class="admin-user-management">
    <header class="admin-page-header"><div><span class="admin-page-kicker">Kiểm tra thao tác</span><h1 class="admin-page-title">Nhật ký hoạt động</h1></div></header>
    <div class="admin-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Thời gian</th><th>Hành động</th><th>Mục tiêu</th><th>Chi tiết</th></tr></thead><tbody>
    @foreach (var log in Model)
    {
        <tr><td>@log.CreatedAt.ToLocalTime()</td><td>@log.Action</td><td>@log.TargetUserId</td><td>@log.Details</td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted">Chưa có nhật ký.</td></tr> }
    </tbody></table></div></div>
</section>
