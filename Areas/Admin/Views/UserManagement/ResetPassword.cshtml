@{
    ViewData["Title"] = "Reset Mật Khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Xác nhận Reset Mật Khẩu</h4>
                </div>
                <div class="card-body">
                    <p>Bạn có chắc chắn muốn reset mật khẩu cho tài khoản này không?</p>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <ul class="list-group mb-4">
                        <li class="list-group-item"><strong>Họ tên:</strong> @ViewBag.FullName</li>
                        <li class="list-group-item"><strong>Email:</strong> @ViewBag.Email</li>
                        <li class="list-group-item text-danger">
                            <strong>Mật khẩu mới:</strong> Medislot@2026. Mật khẩu này sẽ được gửi qua email nếu SMTP hoạt động.
                            Người dùng sẽ bị <strong>bắt buộc phải đổi mật khẩu</strong> ở lần đăng nhập tiếp theo.
                        </li>
                    </ul>

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" name="userId" value="@ViewBag.UserId" />
                        <input type="hidden" name="confirmAction" value="true" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-key"></i> Xác nhận Reset
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>