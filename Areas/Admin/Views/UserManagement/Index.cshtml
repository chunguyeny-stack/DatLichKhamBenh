@using System.Linq
@model IEnumerable<DatLichKhamBenh.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý người dùng";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string>;
    var users = Model.ToList();
}

<section class="admin-user-management">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-kicker">Khu vực quản trị</span>
            <h1 class="admin-page-title">@ViewData["Title"]</h1>
            <p class="admin-page-description">Theo dõi và quản lý tài khoản người dùng MediSlot.</p>
        </div>
        <a asp-action="CreateStaff" class="admin-create-button">Tạo tài khoản nhân sự</a>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h2>Danh sách tài khoản</h2>
                <p>Thông tin vai trò, trạng thái và thao tác quản trị.</p>
            </div>
            <span class="admin-user-count">@users.Count tài khoản</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover admin-user-table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Họ tên</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (users.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="py-5 text-center text-muted">Chưa có tài khoản nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            var role = userRoles != null && userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "N/A";
                            var isLocked = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now;
                            var statusText = isLocked ? "Bị khóa" : "Hoạt động";
                            var statusBadge = isLocked ? "admin-status-locked" : "admin-status-active";
                            var fullName = $"{user.MiddleName} {user.FirstName}".Trim();

                            <tr>
                                <td>@user.Email</td>
                                <td>@fullName</td>
                                <td><span class="admin-role-badge">@role</span></td>
                                <td>
                                    <span class="badge @statusBadge">@statusText</span>
                                    @if (isLocked && !string.IsNullOrEmpty(user.LockoutReason))
                                    {
                                        <br /><small class="text-muted">Lý do: @user.LockoutReason</small>
                                    }
                                </td>
                                <td>
                                    <div class="admin-table-actions">
                                        <a asp-action="EditUser" asp-route-id="@user.Id"
                                           class="admin-action-button admin-action-reset" title="Sửa tài khoản">Sửa</a>
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id"
                                           class="admin-action-button admin-action-reset" title="Reset mật khẩu">Reset MK</a>
                                        @if (isLocked)
                                        {
                                            <form asp-action="UnlockUser" asp-route-userId="@user.Id" method="post" class="m-0">
                                                <button type="submit" class="admin-action-button admin-action-unlock" title="Mở khóa">Mở khóa</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="LockUser" asp-route-id="@user.Id"
                                               class="admin-action-button admin-action-lock" title="Khóa tài khoản">Khóa</a>
                                        }
                                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="m-0"
                                              onsubmit="return confirm('Chuyển tài khoản này vào thùng rác?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-action-button admin-action-delete" title="Chuyển vào thùng rác"><i class="bi bi-trash"></i> Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>