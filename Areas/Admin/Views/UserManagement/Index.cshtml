@model IEnumerable<DatLichKhamBenh.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý người dùng";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string>;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="CreateStaff" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Tạo tài khoản nhân sự
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Họ tên</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var role = userRoles != null && userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "N/A";
                        var isLocked = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now;
                        var statusText = isLocked ? "Bị khóa" : "Hoạt động";
                        var statusBadge = isLocked ? "bg-danger" : "bg-success";
                        var fullName = $"{user.MiddleName} {user.FirstName}".Trim();

                        <tr>
                            <td>@user.Email</td>
                            <td>@fullName</td>
                            <td><span class="badge bg-info text-dark">@role</span></td>
                            <td>
                                <span class="badge @statusBadge">@statusText</span>
                                @if (isLocked && !string.IsNullOrEmpty(user.LockoutReason))
                                {
                                    <br /><small class="text-muted">Lý do: @user.LockoutReason</small>
                                }
                            </td>
                            <td class="text-end">
                                <!-- Nút Reset Mật Khẩu -->
                                <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning" title="Reset mật khẩu">
                                    <i class="bi bi-key"></i> Reset MK
                                </a>

                                <!-- Nút Khóa / Mở khóa -->
                                @if (isLocked)
                                {
                                    <form asp-action="UnlockUser" asp-route-userId="@user.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa">
                                            <i class="bi bi-unlock"></i> Mở khóa
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-action="LockUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger" title="Khóa tài khoản">
                                        <i class="bi bi-lock"></i> Khóa
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Nếu bạn dùng Bootstrap Icons, hãy đảm bảo đã include thư viện này trong _Layout.cshtml -->
}