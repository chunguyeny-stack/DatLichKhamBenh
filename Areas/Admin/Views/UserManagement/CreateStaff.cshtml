@model DatLichKhamBenh.Models.ViewModels.CreateStaffViewModel
@{
    ViewData["Title"] = "Tạo tài khoản nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    // Lấy danh sách chuyên khoa từ ViewBag do Controller truyền sang
    var specialties = ViewBag.Specialties as List<DatLichKhamBenh.Models.Entities.Specialty>;
}

<!-- ... (Giữ nguyên phần <style> như cũ) ... -->

<div class="container">
    <div class="form-container">
        <a asp-action="Index" class="btn-back-link"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>

        <h2 class="form-title">Thêm Nhân Sự Mới</h2>
        <p class="helper-text">Tạo tài khoản Bác sĩ, Lễ tân hoặc Admin. Mật khẩu khởi tạo là
            <strong>Medislot@2026</strong>; người dùng bắt buộc phải đổi mật khẩu ở lần đăng nhập đầu tiên.</p>

            <form asp-action="CreateStaff" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Họ đệm</label>
                        <input asp-for="MiddleName" class="form-control" placeholder="Ví dụ: Nguyễn Văn" />
                        <span asp-validation-for="MiddleName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tên</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ví dụ: A" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email nhân sự (Dùng làm tên đăng nhập)</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="ten@medislot.com" />
                    <div class="form-text">Tài khoản nhân sự phải dùng miền @@medislot.com.</div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Phân quyền</label>
                    <select asp-for="Role" class="form-control" id="roleSelect">
                        <option value="">-- Chọn vai trò --</option>
                        <option value="Doctor">Bác sĩ (Doctor)</option>
                        <option value="Receptionist">Lễ tân (Receptionist)</option>
                        <option value="Admin">Quản trị viên (Admin)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <!-- Khối chọn chuyên khoa (chỉ hiện khi chọn Bác sĩ) -->
                <div class="mb-4" id="specialtyGroup" style="display: none;">
                    <label class="form-label fw-bold">Chuyên khoa</label>
                    <select asp-for="SpecialtyId" class="form-control">
                        <option value="">-- Chọn chuyên khoa --</option>
                        @if (specialties != null)
                        {
                            foreach (var item in specialties)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SpecialtyId" class="text-danger small"></span>

                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Degree" class="form-label fw-bold"></label>
                            <input asp-for="Degree" class="form-control" placeholder="Ví dụ: Bác sĩ CKI" />
                            <span asp-validation-for="Degree" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="YearsOfExperience" class="form-label fw-bold"></label>
                            <input asp-for="YearsOfExperience" type="number" min="0" max="60" class="form-control" />
                            <span asp-validation-for="YearsOfExperience" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ConsultationFee" class="form-label fw-bold"></label>
                            <input asp-for="ConsultationFee" type="number" min="0" step="1000" class="form-control" />
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Workplace" class="form-label fw-bold"></label>
                            <input asp-for="Workplace" class="form-control" placeholder="Ví dụ: MediSlot" />
                            <span asp-validation-for="Workplace" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-submit"><i class="bi bi-save"></i> Tạo tài khoản</button>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            // Script ẩn/hiện khối chọn chuyên khoa
            document.getElementById('roleSelect').addEventListener('change', function () {
                var specialtyGroup = document.getElementById('specialtyGroup');
                if (this.value === 'Doctor') {
                    specialtyGroup.style.display = 'block';
                } else {
                    specialtyGroup.style.display = 'none';
                }
            });
            document.getElementById('roleSelect').dispatchEvent(new Event('change'));
        </script>
    }