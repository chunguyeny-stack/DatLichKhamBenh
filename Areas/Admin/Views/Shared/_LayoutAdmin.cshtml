@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Quản trị") - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="account-profile-page admin-layout">
    <nav class="top-navbar">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.png" alt="Biểu trưng MediSlot" />
            <span>MediSlot</span>
            <span class="admin-brand-label">Quản trị</span>
        </a>

        <ul class="navbar-menu">
            <li>
                <a asp-area="Admin" asp-controller="Admin" asp-action="Dashboard"
                   class="@(currentController == "Admin" ? "active" : "")">
                    Trang chủ
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                   class="@(currentController == "UserManagement" && currentAction == "Index" ? "active" : "")">
                    Quản lý người dùng
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="UserManagement" asp-action="CreateStaff"
                   class="@(currentAction == "CreateStaff" ? "active" : "")">
                    Tạo tài khoản
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="SpecialtyManager" asp-action="Index"
                   class="@(currentController == "SpecialtyManager" ? "active" : "")">
                    Chuyên khoa
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="RecycleBin" asp-action="Index"
                   class="@(currentController == "RecycleBin" ? "active" : "")">
                    Thùng rác
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="AuditLog" asp-action="Index"
                   class="@(currentController == "AuditLog" ? "active" : "")">
                    Nhật ký
                </a>
            </li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                    <button class="nav-logout-btn text-danger" type="submit">
                        Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </nav>
    <main class="main-content">
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>