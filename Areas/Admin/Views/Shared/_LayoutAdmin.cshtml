<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Quản trị") - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-dark bg-primary px-3">
        <a class="navbar-brand" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">MediSlot - Quản trị</a>
        <div class="d-flex align-items-center gap-3">
            <a class="text-white text-decoration-none" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">Quản lý người dùng</a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button class="btn btn-light btn-sm" type="submit">Đăng xuất</button>
            </form>
        </div>
    </nav>
    <main class="container py-4">
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>