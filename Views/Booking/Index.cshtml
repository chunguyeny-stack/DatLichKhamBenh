@model IEnumerable<DatLichKhamBenh.Models.Entities.Appointment>
@using DatLichKhamBenh.Models.Enums
@{
    ViewData["Title"] = "Danh sách lịch hẹn";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddDays(14).ToString("yyyy-MM-dd");
    var currentFilter = ViewBag.TrangThaiLoc as string;
    var danhSachLichHen = Model ?? Enumerable.Empty<DatLichKhamBenh.Models.Entities.Appointment>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Nunito:wght@700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --pink-main: #DF6688;
        --pink-dark: #C65172;
        --pink-soft: #FCEEF2;
        --pink-banner: #FDF2F5;
        --ink-dark: #1E2432;
        --ink-muted: #5A6275;
        --page-bg: #FAFAFC;
    }

    .ms-page-wrap,
    .ms-page-wrap * {
        box-sizing: border-box;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-family: 'Be Vietnam Pro', sans-serif;
    }

    .ms-page-wrap {
        background-color: var(--page-bg);
        color: var(--ink-dark);
        min-height: 100vh;
    }

    .ms-topbar {
        background-color: #FFFFFF;
        border: none;
        width: 100%;
    }

    .ms-topbar-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
    }

    .ms-topbar-left {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 36px;
    }

    .ms-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-family: 'Nunito', sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: #4A4A4A;
        border: none;
    }

    .ms-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 24px;
    }

    .ms-nav a {
        text-decoration: none;
        font-size: 14.5px;
        font-weight: 600;
        color: var(--ink-dark);
        border: none;
    }

    .ms-nav a.is-active,
    .ms-nav a:hover {
        color: var(--pink-main);
    }

    .ms-topbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ms-user-email {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink-dark);
    }

    .ms-btn-pink,
    .ms-btn-register {
        background-color: var(--pink-main);
        color: #FFFFFF;
        border: none;
        padding: 8px 20px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }

    .ms-btn-pink:hover,
    .ms-btn-register:hover {
        background-color: var(--pink-dark);
        color: #FFFFFF;
    }

    .ms-btn-login {
        background-color: #FFFFFF;
        color: var(--pink-main);
        border: none;
        padding: 8px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .ms-btn-login:hover {
        background-color: var(--pink-soft);
        color: var(--pink-dark);
    }

    .appt-wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 28px 20px 60px;
    }

    .appt-banner {
        background-color: var(--pink-banner);
        border: none;
        padding: 24px 28px;
        margin-bottom: 20px;
    }

    .appt-title {
        font-family: 'Nunito', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: var(--ink-dark);
        margin: 0;
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
    }

    .filter-tab {
        border: none;
        background-color: var(--pink-banner);
        color: var(--ink-dark);
        padding: 8px 16px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
    }

    .filter-tab:hover {
        background-color: var(--pink-soft);
        color: var(--pink-main);
    }

    .filter-tab.active-tab {
        background-color: var(--pink-main);
        color: #FFFFFF;
    }

    .appt-table-box {
        background-color: var(--pink-banner);
        border: none;
        padding: 16px 20px;
    }

    .appt-table thead th {
        background-color: var(--pink-soft);
        color: var(--ink-dark);
        font-weight: 700;
        border: none;
        white-space: nowrap;
        padding: 12px 14px;
    }

    .appt-table td {
        background-color: #FFFFFF;
        border: none;
        padding: 12px 14px;
        vertical-align: top;
        font-size: 13.5px;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 700;
        background-color: var(--pink-soft);
        color: var(--pink-main);
        border: none;
    }

    .reschedule-box {
        margin-top: 8px;
        padding-top: 8px;
        border: none;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 190px;
    }

    .btn-reschedule {
        background-color: var(--pink-soft);
        color: var(--pink-main);
        border: none;
        padding: 6px 10px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-reschedule:hover {
        background-color: var(--pink-main);
        color: #FFFFFF;
    }
</style>

<div class="ms-page-wrap">
    <header class="ms-topbar">
        <div class="ms-topbar-inner">
            <div class="ms-topbar-left">
                <a asp-controller="Home" asp-action="Index" class="ms-brand" title="Về trang chủ">
                    <svg width="32" height="32" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M30 30H16C11.5817 30 8 26.4183 8 22C8 18.2 10.65 15.02 14.2 14.2C15.02 10.65 18.2 8 22 8C26.4183 8 30 11.5817 30 16V30Z" fill="#D59ECA"/>
                        <path d="M34 30V16C34 11.5817 37.5817 8 42 8C45.8 8 48.98 10.65 49.8 14.2C53.35 15.02 56 18.2 56 22C56 26.4183 52.4183 30 48 30H34Z" fill="#77B800"/>
                        <path d="M30 34V48C30 52.4183 26.4183 56 22 56C18.2 56 15.02 53.35 14.2 49.8C10.65 48.98 8 45.8 8 42C8 37.5817 11.5817 34 16 34H30Z" fill="#00A6EB"/>
                        <path d="M34 34H48C52.4183 34 56 37.5817 56 42C56 45.8 53.35 48.98 49.8 49.8C48.98 53.35 45.8 56 42 56C37.5817 56 34 52.4183 34 48V34Z" fill="#F9EBF2" stroke="#EBC1D3" stroke-width="1.5"/>
                    </svg>
                    <span>MediSlot</span>
                </a>

                <nav class="ms-nav">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <a asp-controller="Doctor" asp-action="Index">Tìm kiếm BS</a>
                    <a asp-controller="Booking" asp-action="Create">Đặt lịch khám</a>
                    <a asp-controller="Booking" asp-action="Appointments" class="is-active">Lịch sử khám</a>
                </nav>
            </div>

            <div class="ms-topbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="ms-user-email">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                        <button type="submit" class="ms-btn-pink">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="ms-btn-login">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="ms-btn-register">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <div class="appt-wrap">
        <div class="appt-banner">
            <h2 class="appt-title">Danh sách lịch hẹn</h2>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0">@TempData["ErrorMessage"]</div>
        }

        <div class="filter-bar">
            <a asp-action="Appointments" class="filter-tab @(string.IsNullOrEmpty(currentFilter) ? "active-tab" : "")">Tất cả</a>
            <a asp-action="Appointments" asp-route-trangThaiLoc="ChoXacNhan" class="filter-tab @(currentFilter == "ChoXacNhan" ? "active-tab" : "")">Chờ xác nhận</a>
            <a asp-action="Appointments" asp-route-trangThaiLoc="DaXacNhan" class="filter-tab @(currentFilter == "DaXacNhan" ? "active-tab" : "")">Đã xác nhận</a>
            <a asp-action="Appointments" asp-route-trangThaiLoc="HoanThanh" class="filter-tab @(currentFilter == "HoanThanh" ? "active-tab" : "")">Hoàn thành</a>
            <a asp-action="Appointments" asp-route-trangThaiLoc="DaHuy" class="filter-tab @(currentFilter == "DaHuy" ? "active-tab" : "")">Đã hủy</a>
        </div>

        <div class="table-responsive appt-table-box">
            <table class="table appt-table mb-0">
                <thead>
                    <tr>
                        <th>Bác sĩ</th>
                        <th>Chuyên khoa</th>
                        <th>Ngày &amp; Khung giờ</th>
                        <th>Triệu chứng / Ghi chú</th>
                        <th>Phí khám</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in danhSachLichHen)
                    {
                        var doc = item.Doctor;
                        var tenBs = doc?.FullName ?? doc?.User?.FullName ?? doc?.User?.Email ?? $"Bác sĩ #{item.DoctorId}";
                        var tenHienThi = string.IsNullOrWhiteSpace(doc?.Degree) ? tenBs : $"{doc.Degree} - {tenBs}";
                        var tenKhoa = doc?.Specialty?.Name ?? "Chưa phân khoa";
                        var giaKham = item.ConsultationFee.ToString("N0") + " đ";
                        var ngayFormatted = item.AppointmentDate.ToString("dd/MM/yyyy");
                        var trangThaiText = item.Status ?? "";
                        var choPhepThaoTac = trangThaiText == "ChoXacNhan"
                            || trangThaiText == "DaXacNhan"
                            || trangThaiText == "Chờ xác nhận"
                            || trangThaiText == "Đã xác nhận";

                        <tr>
                            <td>@tenHienThi</td>
                            <td>@tenKhoa</td>
                            <td>
                                <div class="fw-semibold">@ngayFormatted</div>
                                <div class="small text-muted">@item.TimeSlot</div>
                            </td>
                            <td>@item.Symptoms</td>
                            <td><strong style="color: var(--pink-main);">@giaKham</strong></td>
                            <td>
                                <span class="status-badge">@trangThaiText</span>
                            </td>
                            <td>
                                @if (choPhepThaoTac)
                                {
                                    <form asp-action="CancelAppointment" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 w-100" onclick="return confirm('Hủy lịch hẹn này? (Chỉ áp dụng trước 24h)');">
                                            Hủy lịch
                                        </button>
                                    </form>

                                    <form asp-action="ConfirmReschedule" method="post" class="reschedule-box">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="date" name="ngayMoi" min="@minDate" max="@maxDate" required class="form-control form-control-sm border-0 bg-light" />
                                        <select name="caMoi" asp-items="Html.GetEnumSelectList<CaKham>()" class="form-select form-select-sm border-0 bg-light"></select>
                                        <button type="submit" class="btn-reschedule w-100">Xác nhận đổi lịch</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>