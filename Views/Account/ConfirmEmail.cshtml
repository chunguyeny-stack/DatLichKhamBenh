@{
    Layout = null;
    var email = ViewBag.Email as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác thực email - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="account-screen bg-light">
    <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
        <div class="card shadow-sm" style="max-width:460px;width:100%">
            <div class="card-body p-4">
                <h3 class="mb-3">Xác thực email</h3>
                <p>Nhập mã OTP 6 số từ email <strong>@email</strong>. Mã có hiệu lực trong 5 phút. Nếu chưa nhận được, hãy kiểm tra thư rác hoặc chọn Gửi lại OTP.</p>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-controller="Account" asp-action="ConfirmEmail" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input name="otp" class="form-control text-center fs-4 mb-3" maxlength="6"
                           inputmode="numeric" pattern="[0-9]{6}" required placeholder="Nhập mã OTP" />
                    <button type="submit" class="btn btn-primary w-100">Xác thực</button>
                </form>

                <form asp-controller="Account" asp-action="ResendOtp" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    <button type="submit" class="btn btn-outline-secondary w-100">Gửi lại OTP</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
