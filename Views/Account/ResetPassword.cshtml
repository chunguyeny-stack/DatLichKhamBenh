@{
    Layout = null;
    var userId = ViewBag.UserId as string ?? "";
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="account-screen bg-light">
    <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
        <div class="card shadow-sm" style="max-width:460px;width:100%">
            <div class="card-body p-4">
                <h3 class="mb-3">Đặt lại mật khẩu</h3>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@userId" />
                    <input type="hidden" name="token" value="@token" />
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <input name="password" type="password" class="form-control" minlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu</label>
                        <input name="confirmPassword" type="password" class="form-control" minlength="8" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Cập nhật mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
