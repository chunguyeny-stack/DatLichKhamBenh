@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]) - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* CSS đồng bộ với Login */
        body {
            background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 50%, #f8fafc 100%);
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: #1b1b1b;
        }
        .glass-container {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            width: 100%;
            max-width: 440px;
            padding: 44px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.7);
            position: relative;
        }
        .logo-header { display: flex; align-items: center; margin-bottom: 24px; }
        .logo-img { height: 34px; margin-right: 12px; }
        .logo-text { font-size: 1.5rem; font-weight: 600; color: #5e5e5e; letter-spacing: -0.5px; }
        h2 { font-size: 1.75rem; font-weight: 600; margin-bottom: 8px; color: #1a1a1a; }
        .subtitle { font-size: 0.9rem; color: #666; margin-bottom: 24px; line-height: 1.5; }
        .form-control {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 10px 14px;
            font-size: 1rem;
            background-color: #fff;
            box-shadow: none;
        }
        .form-control:focus { border-color: #0067b8; outline: none; box-shadow: 0 0 0 1px #0067b8; }
        .btn-primary {
            background-color: #0067b8;
            border: 1px solid #0067b8;
            border-radius: 4px;
            padding: 10px;
            width: 100%;
            font-weight: 600;
            font-size: 1rem;
            color: #ffffff !important;
            margin-top: 10px;
        }
        .btn-primary:hover { background-color: #005da6; border-color: #005da6; }
        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            color: #1b1b1b;
            font-size: 1.2rem;
            text-decoration: none;
        }
        .btn-back:hover { color: #0067b8; }
        .links a { color: #0067b8; text-decoration: none; font-size: 0.95rem; }
        .links a:hover { text-decoration: underline; }
        
        /* CSS cho thông báo thành công */
        .alert-success {
            background-color: #d1e7dd;
            border-color: #badbcc;
            color: #0f5132;
            font-size: 0.9rem;
            border-radius: 4px;
        }
    </style>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="account-screen">
    <div class="glass-container">
        <a asp-controller="Account" asp-action="Login" class="btn-back" title="Quay lại đăng nhập">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="logo-header">
            <img src="~/images/logo.png" alt="MediSlot Logo" class="logo-img" />
            <span class="logo-text">MediSlot</span>
        </div>

        <h2>Quên mật khẩu?</h2>
        <p class="subtitle">Nhập địa chỉ email đã đăng ký. Nếu tài khoản tồn tại, hướng dẫn đặt lại mật khẩu sẽ được gửi đến hộp thư của bạn.</p>
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-3">
                <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            
            <div class="form-group mb-4">
                <input name="email" type="email" class="form-control" placeholder="Nhập địa chỉ Email của bạn" required />
            </div>

            <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
        </form>

        <div class="links mt-4 text-center">
            <p class="mb-0">Đã nhớ ra mật khẩu? <a asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a></p>
        </div>
    </div>
</body>
</html>