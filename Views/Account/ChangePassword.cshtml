@model DatLichKhamBenh.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]) - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: url('https://i.pinimg.com/1200x/de/7f/79/de7f7963f12bfd74d5f94be340e4381e.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: #1b1b1b;
        }
        .glass-container {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            width: 100%;
            max-width: 440px;
            padding: 44px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.7);
            position: relative;
        }
        .logo-header { display: flex; align-items: center; margin-bottom: 24px; }
        .logo-img { height: 34px; margin-right: 12px; }
        .logo-text { font-size: 1.5rem; font-weight: 600; color: #5e5e5e; letter-spacing: -0.5px; }
        h2 { font-size: 1.75rem; font-weight: 600; margin-bottom: 10px; color: #1a1a1a; }
        .subtitle { font-size: 0.9rem; color: #666; margin-bottom: 24px; line-height: 1.4; }
        .form-control {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 10px 14px;
            font-size: 1rem;
            background-color: #fff;
            box-shadow: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .form-control:focus { border-color: #0067b8; outline: none; box-shadow: 0 0 0 1px #0067b8; }
        .form-control::placeholder { color: #767676; font-size: 0.95rem; }
        .btn-primary {
            background-color: #0067b8;
            border: 1px solid #0067b8;
            border-radius: 4px;
            padding: 10px;
            width: 100%;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 10px;
            transition: background-color 0.2s;
            color: #ffffff !important;
        }
        .btn-primary:hover { background-color: #005da6; border-color: #005da6; color: #ffffff !important; }
        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            color: #1b1b1b;
            font-size: 1.2rem;
            text-decoration: none;
            transition: color 0.2s;
        }
        .btn-back:hover { color: #0067b8; }
        .password-wrapper { position: relative; }
        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #767676;
            z-index: 10;
        }
    </style>
</head>
<body>

    <div class="glass-container">
        <a asp-controller="Account" asp-action="Profile" class="btn-back" title="Về thông tin cá nhân">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="logo-header">
            <img src="~/images/logo.png" alt="MediSlot Logo" class="logo-img" />
            <span class="logo-text">MediSlot</span>
        </div>

        <h2>Đổi mật khẩu</h2>
        <p class="subtitle">Đây là lần đăng nhập đầu tiên của bạn. Vui lòng đổi mật khẩu để tiếp tục sử dụng hệ thống.</p>
        
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            
            <div class="form-group mb-3">
                <div class="password-wrapper">
                    <input asp-for="OldPassword" type="password" id="oldPassword" class="form-control" placeholder="Mật khẩu hiện tại" />
                    <i class="bi bi-eye-slash toggle-password" onclick="togglePassword('oldPassword', this)"></i>
                </div>
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <div class="password-wrapper">
                    <input asp-for="NewPassword" type="password" id="newPassword" class="form-control" placeholder="Mật khẩu mới" />
                    <i class="bi bi-eye-slash toggle-password" onclick="togglePassword('newPassword', this)"></i>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" id="confirmPassword" class="form-control" placeholder="Xác nhận mật khẩu mới" />
                    <i class="bi bi-eye-slash toggle-password" onclick="togglePassword('confirmPassword', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
        </form>
    </div>

    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }
        }
    </script>
</body>
</html>