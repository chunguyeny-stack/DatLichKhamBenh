@model DatLichKhamBenh.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]) - MediSlot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 50%, #f8fafc 100%);
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 0;
            margin: 0;
            color: #1b1b1b;
        }

        .glass-container {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            width: 100%;
            max-width: 500px;
            padding: 44px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.7);
            position: relative;
        }

        .logo-header { display: flex; align-items: center; margin-bottom: 24px; }
        .logo-img { height: 34px; margin-right: 12px; }
        .logo-text { font-size: 1.5rem; font-weight: 600; color: #5e5e5e; letter-spacing: -0.5px; }

        h2 { font-size: 1.75rem; font-weight: 600; margin-bottom: 8px; color: #1a1a1a; }
        .subtitle { font-size: 0.9rem; color: #666; margin-bottom: 24px; }

        .form-control {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 10px 14px;
            font-size: 1rem;
            background-color: #fff;
            box-shadow: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-control:focus {
            border-color: #0067b8;
            outline: none;
            box-shadow: 0 0 0 1px #0067b8;
        }

        .form-control::placeholder { color: #767676; font-size: 0.95rem; }
        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            color: #1b1b1b;
            font-size: 1.2rem;
            text-decoration: none;
            transition: color 0.2s;
        }
        .btn-back:hover { color: #0067b8; }
        input[type="date"] {
            color: #1b1b1b;
        }

        .btn-primary {
            background-color: #0067b8;
            border: 1px solid #0067b8;
            border-radius: 4px;
            padding: 10px;
            width: 100%;
            font-weight: 600;
            font-size: 1rem;
            transition: background-color 0.2s;
            margin-top: 8px;
            color: #ffffff !important;
        }

        .btn-primary:hover { background-color: #005da6; border-color: #005da6; color: #ffffff !important; }
        .btn-google {
            background-color: #fff;
            border: 1px solid #8c8c8c;
            border-radius: 4px;
            color: #1b1b1b;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 10px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            margin-top: 16px;
            transition: background-color 0.2s;
        }

        .btn-google:hover { background-color: #f3f2f1; border-color: #8c8c8c; }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 24px 0;
            color: #666;
            font-size: 0.9rem;
        }

        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #d1d1d1; }
        .divider:not(:empty)::before { margin-right: 12px; }
        .divider:not(:empty)::after { margin-left: 12px; }

        .links a { color: #0067b8; text-decoration: none; font-size: 0.95rem; }
        .links a:hover { text-decoration: underline; }

        .password-wrapper { position: relative; }
        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #767676;
            z-index: 10;
        }
    </style>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="account-screen">
    <div class="glass-container">
        <a asp-controller="Home" asp-action="Index" class="btn-back" title="Về trang chủ">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="logo-header">
            <img src="~/images/logo.png" alt="MediSlot Logo" class="logo-img" />
            <span class="logo-text">MediSlot</span>
        </div>

        <h2>Tạo tài khoản</h2>
        <p class="subtitle">Dành cho Bệnh nhân. Nhân sự (BS/Lễ tân) vui lòng liên hệ Admin.</p>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <input asp-for="MiddleName" class="form-control" placeholder="Họ đệm" />
                    <span asp-validation-for="MiddleName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <input asp-for="FirstName" class="form-control" placeholder="Tên" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-group mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="form-group mb-3">
                <input asp-for="PhoneNumber" class="form-control" placeholder="Số điện thoại" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="form-group mb-3">
                @{
                    var maxDate = DateTime.Now.ToString("yyyy-MM-dd");
                    var minDate = DateTime.Now.AddYears(-100).ToString("yyyy-MM-dd");
                }
                <input asp-for="DateOfBirth" type="date" min="@minDate" max="@maxDate" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>
            <div class="form-group mb-3">
                <div class="password-wrapper">
                    <input asp-for="Password" type="password" id="regPassword" class="form-control" placeholder="Mật khẩu" />
                    <i class="bi bi-eye-slash toggle-password" onclick="togglePassword('regPassword', this)"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-group mb-3">
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" class="form-control" placeholder="Xác nhận mật khẩu" />
                    <i class="bi bi-eye-slash toggle-password" onclick="togglePassword('regConfirmPassword', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Đăng ký</button>
        </form>

        <div class="divider">hoặc</div>
        <form asp-action="ExternalLogin" asp-route-returnUrl="@(ViewData["ReturnUrl"])" method="post">
            <button type="submit" class="btn-google" name="provider" value="Google">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px" style="margin-right: 8px;">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                </svg>
                Đăng ký nhanh bằng Google
            </button>
        </form>
        <div class="links text-center mt-4">
            <p class="mb-0">Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a></p>
        </div>
    </div>

    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>