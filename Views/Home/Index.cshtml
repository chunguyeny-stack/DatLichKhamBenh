@using DatLichKhamBenh.Models.Entities
@using System.Globalization
@{
    ViewData["Title"] = "Trang chủ";
    var specialties = ViewBag.Specialties as IEnumerable<Specialty> ?? [];
    var featuredDoctors = ViewBag.FeaturedDoctors as IEnumerable<Doctor> ?? [];
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Nunito:wght@700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --pink-main: #DF6688;
        --pink-dark: #C65172;
        --pink-soft: #FCEEF2;
        --pink-banner: #FDF2F5;
        --ink-dark: #1E2432;
        --ink-muted: #5A6275;
        --page-bg: #FAFAFC;
        --line-soft: #E5DCE0;
    }

    .ms-page-wrap,
    .ms-page-wrap * {
        box-sizing: border-box;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-family: 'Be Vietnam Pro', sans-serif;
    }

    .ms-page-wrap {
        background-color: var(--page-bg);
        color: var(--ink-dark);
        min-height: 100vh;
    }

    .ms-topbar {
        background-color: #FFFFFF;
        border: none;
        width: 100%;
    }

    .ms-topbar-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
    }

    .ms-topbar-left {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 36px;
    }

    .ms-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-family: 'Nunito', sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: #4A4A4A;
        border: none;
    }

    .ms-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 24px;
    }

    .ms-nav a {
        text-decoration: none;
        font-size: 14.5px;
        font-weight: 600;
        color: var(--ink-dark);
        border: none;
    }

    .ms-nav a.is-active,
    .ms-nav a:hover {
        color: var(--pink-main);
    }

    .ms-topbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ms-user-email {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink-dark);
    }

    .ms-btn-pink,
    .ms-btn-register {
        background-color: var(--pink-main);
        color: #FFFFFF;
        border: none;
        padding: 8px 20px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }

    .ms-btn-pink:hover,
    .ms-btn-register:hover {
        background-color: var(--pink-dark);
        color: #FFFFFF;
    }

    .ms-btn-login {
        background-color: #FFFFFF;
        color: var(--pink-main);
        border: none;
        padding: 8px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .ms-btn-login:hover {
        background-color: var(--pink-soft);
        color: var(--pink-dark);
    }

    .home-wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 20px 60px;
    }

    .home-hero {
        background-color: var(--pink-banner);
        padding: 36px 40px 40px;
        margin-bottom: 24px;
    }

    .home-hero-badge {
        display: inline-block;
        background-color: #FFFFFF;
        color: var(--pink-main);
        font-size: 13px;
        font-weight: 600;
        padding: 6px 14px;
        margin-bottom: 18px;
    }

    .home-hero-title {
        font-family: 'Be Vietnam Pro', 'Nunito', sans-serif;
        font-size: 38px;
        font-weight: 700;
        color: var(--ink-dark);
        line-height: 1.25;
        margin: 0 0 24px 0;
    }

    .home-hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #FFFFFF;
        color: var(--pink-main);
        border: 1px solid var(--pink-main) !important;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .home-hero-cta:hover {
        background-color: var(--pink-main);
        color: #FFFFFF;
    }

    .home-search-box {
        background-color: var(--pink-banner);
        padding: 28px 32px;
    }

    .home-search-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .home-search-heading {
        font-family: 'Be Vietnam Pro', 'Nunito', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: var(--ink-dark);
        margin: 0;
    }

    .home-view-all {
        background-color: #FFFFFF;
        color: var(--pink-main);
        border: 1px solid var(--pink-main) !important;
        padding: 7px 16px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .home-view-all:hover {
        background-color: var(--pink-soft);
        color: var(--pink-dark);
    }

    .home-search-box .form-label {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--ink-dark);
        margin-bottom: 8px;
    }

    .home-search-box .form-control,
    .home-search-box .form-select {
        background-color: #FFFFFF;
        border: 1px solid var(--line-soft) !important;
        padding: 10px 14px;
        font-size: 14px;
        color: var(--ink-dark);
        height: 44px;
    }

    .home-search-box .form-control:focus,
    .home-search-box .form-select:focus {
        border-color: var(--pink-main) !important;
        outline: none;
    }

    .home-btn-search {
        background-color: var(--pink-main);
        color: #FFFFFF;
        border: none;
        height: 44px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        width: 100%;
    }

    .home-btn-search:hover {
        background-color: var(--pink-dark);
        color: #FFFFFF;
    }

    .home-featured {
        margin-top: 24px;
    }

    .home-featured-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .home-featured-title {
        font-family: 'Be Vietnam Pro', 'Nunito', sans-serif;
        font-size: 22px;
        font-weight: 700;
        margin: 0;
    }

    .home-featured-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .home-featured-card {
        background-color: #FFFFFF;
        border: 1px solid var(--line-soft) !important;
        display: flex;
        flex-direction: column;
        min-height: 220px;
    }

    .home-featured-body {
        padding: 20px;
        flex: 1;
    }

    .home-featured-name {
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 12px;
    }

    .home-featured-meta {
        color: var(--ink-muted);
        font-size: 13.5px;
        margin: 0 0 7px;
    }

    .home-featured-meta strong {
        color: var(--ink-dark);
    }

    .home-featured-actions {
        display: flex;
        gap: 10px;
        padding: 12px 20px;
        background-color: var(--pink-banner);
    }

    .home-featured-actions a {
        flex: 1;
        text-align: center;
        padding: 8px 10px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
    }

    .home-featured-detail {
        background-color: #FFFFFF;
        color: var(--ink-dark);
        border: 1px solid var(--line-soft) !important;
    }

    .home-featured-book {
        background-color: var(--pink-main);
        color: #FFFFFF;
        border: 1px solid var(--pink-main) !important;
    }

    .home-featured-empty {
        background-color: var(--pink-banner);
        padding: 20px;
    }

    @@media (min-width: 768px) {
        .home-featured-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767px) {
        .home-featured-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="ms-page-wrap">
    <header class="ms-topbar">
        <div class="ms-topbar-inner">
            <div class="ms-topbar-left">
                <a asp-controller="Home" asp-action="Index" class="ms-brand" title="Về trang chủ">
                    <svg width="32" height="32" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M30 30H16C11.5817 30 8 26.4183 8 22C8 18.2 10.65 15.02 14.2 14.2C15.02 10.65 18.2 8 22 8C26.4183 8 30 11.5817 30 16V30Z" fill="#D59ECA"/>
                        <path d="M34 30V16C34 11.5817 37.5817 8 42 8C45.8 8 48.98 10.65 49.8 14.2C53.35 15.02 56 18.2 56 22C56 26.4183 52.4183 30 48 30H34Z" fill="#77B800"/>
                        <path d="M30 34V48C30 52.4183 26.4183 56 22 56C18.2 56 15.02 53.35 14.2 49.8C10.65 48.98 8 45.8 8 42C8 37.5817 11.5817 34 16 34H30Z" fill="#00A6EB"/>
                        <path d="M34 34H48C52.4183 34 56 37.5817 56 42C56 45.8 53.35 48.98 49.8 49.8C48.98 53.35 45.8 56 42 56C37.5817 56 34 52.4183 34 48V34Z" fill="#F9EBF2" stroke="#EBC1D3" stroke-width="1.5"/>
                    </svg>
                    <span>MediSlot</span>
                </a>

                <nav class="ms-nav">
                    <a asp-controller="Home" asp-action="Index" class="is-active">Trang chủ</a>
                    <a asp-controller="Doctor" asp-action="Index">Tìm kiếm BS</a>
                    <a asp-controller="Booking" asp-action="Create">Đặt lịch khám</a>
                    <a asp-controller="Patient" asp-action="Appointments">Lịch sử khám</a>
                </nav>
            </div>

            <div class="ms-topbar-right">
                @if (User.Identity is { IsAuthenticated: true })
                {
                    <a asp-controller="Account" asp-action="Profile" class="ms-user-email" style="text-decoration: none;">@User.Identity.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ms-btn-pink">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="ms-btn-login">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="ms-btn-register">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <div class="home-wrap">
        <section class="home-hero">
            <span class="home-hero-badge">Tiêu Chuẩn Y Khoa Toàn Diện</span>
            <h1 class="home-hero-title">Đặt lịch khám &amp; Tìm kiếm bác sĩ</h1>
            <a asp-controller="Booking" asp-action="Create" class="home-hero-cta">+ Đặt lịch khám ngay</a>
        </section>

        <section class="home-search-box">
            <div class="home-search-top">
                <h2 class="home-search-heading">Tìm kiếm Bác sĩ</h2>
                <a asp-controller="Doctor" asp-action="Index" class="home-view-all">Xem tất cả bác sĩ &rarr;</a>
            </div>

            <form asp-controller="Doctor" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="tenBacSi" class="form-label">Tên bác sĩ / Học vị</label>
                    <input id="tenBacSi"
                           type="text"
                           name="tenBacSi"
                           class="form-control"
                           placeholder="Nhập tên hoặc học vị bác sĩ..."/>
                </div>

                <div class="col-md-5">
                    <label for="specialtyId" class="form-label">Chuyên khoa</label>
                    <select id="specialtyId" name="specialtyId" class="form-select">
                        <option value="">-- Tất cả chuyên khoa --</option>
                        @foreach (var item in specialties)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="home-btn-search">Tìm kiếm BS</button>
                </div>
            </form>
        </section>

        <section class="home-featured">
            <div class="home-featured-header">
                <h2 class="home-featured-title">Bác sĩ nổi bật</h2>
                <a asp-controller="Doctor" asp-action="Index" class="home-view-all">Xem tất cả bác sĩ &rarr;</a>
            </div>

            @if (!featuredDoctors.Any())
            {
                <div class="home-featured-empty">Chưa có dữ liệu bác sĩ nổi bật.</div>
            }
            else
            {
                <div class="home-featured-grid">
                    @foreach (var doctor in featuredDoctors)
                    {
                        var doctorName = !string.IsNullOrWhiteSpace(doctor.FullName)
                            ? doctor.FullName
                            : (doctor.User?.FullName
                               ?? doctor.User?.Email
                               ?? $"Bác sĩ #{doctor.Id}");
                        var displayName = string.IsNullOrWhiteSpace(doctor.Degree)
                            ? doctorName
                            : $"{doctor.Degree} - {doctorName}";
                        var fee = (doctor.ConsultationFee > 0 ? doctor.ConsultationFee : 200000m)
                            .ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));

                        <article class="home-featured-card">
                            <div class="home-featured-body">
                                <h3 class="home-featured-name">@displayName</h3>
                                <p class="home-featured-meta">Chuyên khoa: <strong>@(doctor.Specialty?.Name ?? "Chưa phân khoa")</strong></p>
                                <p class="home-featured-meta">Kinh nghiệm: <strong>@(doctor.YearsOfExperience > 0 ? $"{doctor.YearsOfExperience} năm" : "Đang cập nhật")</strong></p>
                                <p class="home-featured-meta">Giá khám: <strong>@fee đ</strong></p>
                            </div>
                            <div class="home-featured-actions">
                                <a asp-controller="Doctor" asp-action="Details" asp-route-id="@doctor.Id" class="home-featured-detail">Chi tiết</a>
                                <a asp-controller="Booking" asp-action="Create" asp-route-doctorId="@doctor.Id" class="home-featured-book">Đặt lịch</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

    </div>
</div>
